<Window
    x:Class="VisualInspectionTrainingSystem.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Visual Inspection Training System"
    Width="800"
    Height="450"
    MinWidth="640"
    MinHeight="400"
    AutomationProperties.Name="Visual Inspection Training System"
    Background="{StaticResource App.LightMutedSurfaceBrush}"
    KeyboardNavigation.TabNavigation="Cycle"
    WindowStartupLocation="CenterScreen">
    <Grid Margin="{StaticResource Spacing.Large}">
        <Border
            Padding="{StaticResource Spacing.Large}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource App.LightSurfaceBrush}"
            BorderBrush="{StaticResource App.LightBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius.Large}">
            <StackPanel MaxWidth="520">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource App.LightTextBrush}"
                    Text="Visual Inspection Training System"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,12,0,0"
                    Foreground="{StaticResource App.LightSecondaryTextBrush}"
                    Text="Use the sign-in window to begin training or administration."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
