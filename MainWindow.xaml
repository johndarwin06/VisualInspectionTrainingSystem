<mah:MetroWindow
    x:Class="VisualInspectionTrainingSystem.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Visual Inspection Training System"
    Width="1280"
    Height="800"
    MinWidth="960"
    MinHeight="640"
    AutomationProperties.Name="Visual Inspection Training System workspace"
    Background="{DynamicResource App.BackgroundBrush}"
    BorderBrush="{DynamicResource App.BorderBrush}"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    ShowIconOnTitleBar="False"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The shell is the only global navigation surface after authentication. -->
        <Border
            Grid.Column="0"
            Panel.ZIndex="10"
            Style="{StaticResource AuthenticatedShellNavigationRailStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource App.SecondaryBrush}"
                        CornerRadius="16"
                        materialDesign:ElevationAssist.Elevation="Dp4">
                        <materialDesign:PackIcon
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Visual inspection training"
                            Foreground="White"
                            Kind="ImageSearchOutline" />
                    </Border>
                    <TextBlock
                        Margin="0,16,0,0"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource App.DarkTextBrush}"
                        Text="VISUAL INSPECTION"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                        Text="Training System" />
                    <Border
                        Margin="0,14,0,0"
                        Padding="10,5"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource App.NavigationRaisedBrush}"
                        CornerRadius="100">
                        <TextBlock
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.SecondaryBrush}"
                            Text="{Binding RoleText}" />
                    </Border>
                </StackPanel>

                <ScrollViewer
                    Grid.Row="2"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            Margin="12,0,0,8"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                            Text="WORKSPACES" />

                        <Button
                            AutomationProperties.Name="Workspace overview"
                            Focusable="False"
                            IsHitTestVisible="False"
                            Style="{StaticResource ActiveShellNavigationButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="HomeOutline" Style="{StaticResource ShellRailIconStyle}" />
                                <TextBlock VerticalAlignment="Center" Text="Overview" />
                            </StackPanel>
                        </Button>

                        <StackPanel Visibility="{Binding TraineeVisibility}">
                            <Button
                                AutomationProperties.Name="Open training setup"
                                Command="{Binding TrainingCommand}"
                                Style="{StaticResource ShellNavigationButtonStyle}"
                                ToolTip="Choose a quiz size and begin training">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="TargetVariant" Style="{StaticResource ShellRailIconStyle}" />
                                    <TextBlock VerticalAlignment="Center" Text="Training" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.Name="Open my training history"
                                Command="{Binding HistoryCommand}"
                                Style="{StaticResource ShellNavigationButtonStyle}"
                                ToolTip="Open personal progress and completed sessions">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="History" Style="{StaticResource ShellRailIconStyle}" />
                                    <TextBlock VerticalAlignment="Center" Text="My Progress" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Visibility="{Binding AdministratorVisibility}">
                            <Button
                                AutomationProperties.Name="Open review workflow"
                                Command="{Binding ReviewWorkflowCommand}"
                                Style="{StaticResource ShellNavigationButtonStyle}"
                                ToolTip="Review trainee inspection answers">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ClipboardCheckOutline" Style="{StaticResource ShellRailIconStyle}" />
                                    <TextBlock VerticalAlignment="Center" Text="Review Workflow" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.Name="Open dashboard"
                                Command="{Binding DashboardCommand}"
                                Style="{StaticResource ShellNavigationButtonStyle}"
                                ToolTip="Open daily operational analytics">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ViewDashboardOutline" Style="{StaticResource ShellRailIconStyle}" />
                                    <TextBlock VerticalAlignment="Center" Text="Dashboard" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.Name="Open reports"
                                Command="{Binding ReportsCommand}"
                                Style="{StaticResource ShellNavigationButtonStyle}"
                                ToolTip="Open period reports and exports">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FileChartOutline" Style="{StaticResource ShellRailIconStyle}" />
                                    <TextBlock VerticalAlignment="Center" Text="Reports" />
                                </StackPanel>
                            </Button>
                            <Button
                                AutomationProperties.Name="Open user management"
                                Command="{Binding UserManagementCommand}"
                                Style="{StaticResource ShellNavigationButtonStyle}"
                                ToolTip="Manage user access and activation">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountCogOutline" Style="{StaticResource ShellRailIconStyle}" />
                                    <TextBlock VerticalAlignment="Center" Text="User Management" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Button
                    Grid.Row="4"
                    AutomationProperties.Name="{Binding ThemeToggleText}"
                    Command="{Binding ToggleThemeCommand}"
                    Style="{StaticResource ShellNavigationButtonStyle}"
                    ToolTip="{Binding ThemeToggleText}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ThemeLightDark" Style="{StaticResource ShellRailIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding ThemeToggleText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Button>

                <materialDesign:Card
                    Grid.Row="6"
                    AutomationProperties.Name="Signed-in profile"
                    Style="{StaticResource ShellProfileCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon
                            Width="27"
                            Height="27"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource App.SecondaryBrush}"
                            Kind="AccountCircleOutline" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource App.DarkTextBrush}"
                                Style="{StaticResource TrimmedTextWithToolTipStyle}"
                                Text="{Binding DisplayName}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                                Style="{StaticResource TrimmedTextWithToolTipStyle}"
                                Text="{Binding EmployeeNumberText}" />
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <Button
                    Grid.Row="8"
                    AutomationProperties.Name="Log out"
                    Command="{Binding LogoutCommand}"
                    Style="{StaticResource DangerActionButtonStyle}"
                    ToolTip="Sign out and return to Login">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Logout" Style="{StaticResource AppIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="Logout" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Overview stays lightweight; feature data loads only after a destination is opened. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="92" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="32,0"
                Background="{DynamicResource App.SurfaceBrush}"
                BorderBrush="{DynamicResource App.DividerBrush}"
                BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{StaticResource PageTitleTextStyle}"
                            Text="{Binding WelcomeText}" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Style="{StaticResource SupportingTextStyle}"
                            Text="{Binding ProfileSummaryText}" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Padding="12,7"
                        VerticalAlignment="Center"
                        Style="{StaticResource StatusChipStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,7,0"
                                Foreground="{DynamicResource App.SuccessBrush}"
                                Kind="ShieldCheckOutline" />
                            <TextBlock FontWeight="SemiBold" Text="Authenticated" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid
                    MaxWidth="1180"
                    Margin="34,30,34,40"
                    Style="{StaticResource ContentEntranceGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource DisplayTitleTextStyle}" Text="Choose a workspace" />
                        <TextBlock
                            Margin="0,7,0,0"
                            MaxWidth="760"
                            FontSize="15"
                            Style="{StaticResource SupportingTextStyle}"
                            Text="Open one focused workspace at a time. Closing it returns you here without changing your authenticated session."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="2" Visibility="{Binding TraineeVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.45*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Padding="28"
                            Background="{DynamicResource App.NavigationBrush}"
                            BorderBrush="{DynamicResource App.NavigationRaisedBrush}"
                            BorderThickness="1"
                            CornerRadius="20"
                            materialDesign:ElevationAssist.Elevation="Dp4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="18" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <Border Width="56" Height="56" HorizontalAlignment="Left" Background="{DynamicResource App.NavigationRaisedBrush}" CornerRadius="17">
                                        <materialDesign:PackIcon Width="31" Height="31" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource App.SecondaryBrush}" Kind="TargetVariant" />
                                    </Border>
                                    <TextBlock Margin="0,20,0,0" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource App.DarkTextBrush}" Text="Inspection training" />
                                    <TextBlock Margin="0,8,0,0" MaxWidth="610" Foreground="{DynamicResource App.DarkSecondaryTextBrush}" Text="Choose a ten- or twenty-question session, inspect each production image, and classify it as GOOD or NG." TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Row="2" MinWidth="180" HorizontalAlignment="Left" AutomationProperties.Name="Open training setup from overview" Command="{Binding TrainingCommand}" Style="{StaticResource PrimaryActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ArrowRight" Style="{StaticResource AppIconStyle}" /><TextBlock Text="Open Training" /></StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource InteractiveCardStyle}">
                            <StackPanel>
                                <Border Width="52" Height="52" HorizontalAlignment="Left" Background="{DynamicResource App.InfoSurfaceBrush}" CornerRadius="16">
                                    <materialDesign:PackIcon Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource App.InfoBrush}" Kind="ChartTimelineVariant" />
                                </Border>
                                <TextBlock Margin="0,18,0,0" Style="{StaticResource SectionTitleTextStyle}" Text="My progress" />
                                <TextBlock Margin="0,7,0,20" Style="{StaticResource SupportingTextStyle}" Text="Explore personal activity, reviewed accuracy, review coverage, and completed-session details." TextWrapping="Wrap" />
                                <Button AutomationProperties.Name="Open personal progress from overview" Command="{Binding HistoryCommand}" Style="{StaticResource SecondaryActionButtonStyle}">
                                    <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ArrowRight" Style="{StaticResource AppIconStyle}" /><TextBlock Text="View Progress" /></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <UniformGrid Grid.Row="2" Columns="2" Rows="2" Visibility="{Binding AdministratorVisibility}">
                        <Border Margin="0,0,10,10" Style="{StaticResource InteractiveCardStyle}"><StackPanel><materialDesign:PackIcon Width="34" Height="34" Foreground="{DynamicResource App.PrimaryBrush}" Kind="ClipboardCheckOutline" /><TextBlock Margin="0,14,0,0" Style="{StaticResource SectionTitleTextStyle}" Text="Review Workflow" /><TextBlock Margin="0,6,0,16" Style="{StaticResource SupportingTextStyle}" Text="Review trainee decisions and maintain reusable GOOD/NG truth." /><Button Command="{Binding ReviewWorkflowCommand}" Content="Open Review" Style="{StaticResource SecondaryActionButtonStyle}" /></StackPanel></Border>
                        <Border Margin="10,0,0,10" Style="{StaticResource InteractiveCardStyle}"><StackPanel><materialDesign:PackIcon Width="34" Height="34" Foreground="{DynamicResource App.InfoBrush}" Kind="ViewDashboardOutline" /><TextBlock Margin="0,14,0,0" Style="{StaticResource SectionTitleTextStyle}" Text="Dashboard" /><TextBlock Margin="0,6,0,16" Style="{StaticResource SupportingTextStyle}" Text="Monitor daily metrics, trends, review coverage, and training time." /><Button Command="{Binding DashboardCommand}" Content="Open Dashboard" Style="{StaticResource SecondaryActionButtonStyle}" /></StackPanel></Border>
                        <Border Margin="0,10,10,0" Style="{StaticResource InteractiveCardStyle}"><StackPanel><materialDesign:PackIcon Width="34" Height="34" Foreground="{DynamicResource App.SuccessBrush}" Kind="FileChartOutline" /><TextBlock Margin="0,14,0,0" Style="{StaticResource SectionTitleTextStyle}" Text="Reports" /><TextBlock Margin="0,6,0,16" Style="{StaticResource SupportingTextStyle}" Text="Compare period charts and tables, then export verified report data." /><Button Command="{Binding ReportsCommand}" Content="Open Reports" Style="{StaticResource SecondaryActionButtonStyle}" /></StackPanel></Border>
                        <Border Margin="10,10,0,0" Style="{StaticResource InteractiveCardStyle}"><StackPanel><materialDesign:PackIcon Width="34" Height="34" Foreground="{DynamicResource App.WarningBrush}" Kind="AccountCogOutline" /><TextBlock Margin="0,14,0,0" Style="{StaticResource SectionTitleTextStyle}" Text="User Management" /><TextBlock Margin="0,6,0,16" Style="{StaticResource SupportingTextStyle}" Text="Create, activate, update, and secure authorized application accounts." /><Button Command="{Binding UserManagementCommand}" Content="Manage Users" Style="{StaticResource SecondaryActionButtonStyle}" /></StackPanel></Border>
                    </UniformGrid>

                    <Border Grid.Row="4" Padding="18,14" Background="{DynamicResource App.SurfaceVariantBrush}" CornerRadius="14">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="23" Height="23" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource App.PrimaryBrush}" Kind="InformationOutline" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SupportingTextStyle}" Text="GOOD and NG are trainee selections. Reviewed accuracy excludes every pending or unsupported administrator truth." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</mah:MetroWindow>
