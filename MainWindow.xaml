<ui:FluentWindow
    x:Class="VisualInspectionTrainingSystem.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Visual Inspection Training System"
    Width="1280"
    Height="800"
    MinWidth="980"
    MinHeight="650"
    AutomationProperties.Name="Visual Inspection Training System workspace"
    ExtendsContentIntoTitleBar="True"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    Style="{StaticResource FluentAppWindowStyle}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Panel.ZIndex="30"
            Icon="{ui:SymbolIcon ImageSearch24}"
            Style="{StaticResource FluentAppTitleBarStyle}"
            Title="Visual Inspection Training System" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="288" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- WPF-UI NavigationView is command-only; existing owned-window navigation remains intact. -->
            <ui:NavigationView
                x:Name="RoleNavigation"
                Grid.Column="0"
                AutomationProperties.Name="Role-aware application navigation"
                HeaderVisibility="Collapsed"
                IsPaneOpen="True"
                IsPaneToggleVisible="False"
                IsTopSeparatorVisible="False"
                OpenPaneLength="288"
                Style="{StaticResource FluentNavigationViewStyle}">

                <ui:NavigationView.PaneHeader>
                    <StackPanel Margin="12,18,12,16">
                        <Border
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource App.PrimaryBrush}"
                            CornerRadius="10">
                            <ui:SymbolIcon
                                Width="27"
                                Height="27"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Symbol="ImageSearch24" />
                        </Border>
                        <TextBlock
                            Margin="0,14,0,0"
                            FontFamily="Segoe UI Variable Display, Segoe UI"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.TextPrimaryBrush}"
                            Text="Visual Inspection" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource App.TextSecondaryBrush}"
                            Text="Training System" />
                        <Border
                            Margin="0,12,0,0"
                            Padding="9,4"
                            HorizontalAlignment="Left"
                            Style="{StaticResource FluentStatusBadgeStyle}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource App.PrimaryBrush}"
                                Text="{Binding RoleText}" />
                        </Border>
                    </StackPanel>
                </ui:NavigationView.PaneHeader>

                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItemHeader Text="WORKSPACES" />

                    <ui:NavigationViewItem
                        AutomationProperties.Name="Workspace overview"
                        Content="Overview"
                        Focusable="False"
                        IsActive="True"
                        IsHitTestVisible="False"
                        Style="{StaticResource FluentNavigationItemStyle}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Home24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        AutomationProperties.Name="Open training setup"
                        Command="{Binding TrainingCommand}"
                        Content="Training"
                        Style="{StaticResource FluentNavigationItemStyle}"
                        ToolTip="Choose a quiz size and begin training"
                        Visibility="{Binding TraineeVisibility}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="Target24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        AutomationProperties.Name="Open my training history"
                        Command="{Binding HistoryCommand}"
                        Content="My progress"
                        Style="{StaticResource FluentNavigationItemStyle}"
                        ToolTip="Open personal progress and completed sessions"
                        Visibility="{Binding TraineeVisibility}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="History24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        AutomationProperties.Name="Open review workflow"
                        Command="{Binding ReviewWorkflowCommand}"
                        Content="Review workflow"
                        Style="{StaticResource FluentNavigationItemStyle}"
                        ToolTip="Review trainee inspection answers"
                        Visibility="{Binding AdministratorVisibility}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="ClipboardTask24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        AutomationProperties.Name="Open dashboard"
                        Command="{Binding DashboardCommand}"
                        Content="Dashboard"
                        Style="{StaticResource FluentNavigationItemStyle}"
                        ToolTip="Open daily operational analytics"
                        Visibility="{Binding AdministratorVisibility}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="DataTrending24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        AutomationProperties.Name="Open reports"
                        Command="{Binding ReportsCommand}"
                        Content="Reports"
                        Style="{StaticResource FluentNavigationItemStyle}"
                        ToolTip="Open period reports and exports"
                        Visibility="{Binding AdministratorVisibility}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="DocumentData24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        AutomationProperties.Name="Open user management"
                        Command="{Binding UserManagementCommand}"
                        Content="User management"
                        Style="{StaticResource FluentNavigationItemStyle}"
                        ToolTip="Manage user access and activation"
                        Visibility="{Binding AdministratorVisibility}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="PeopleTeam24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.PaneFooter>
                    <ui:Card Margin="10,10,10,6" Style="{StaticResource FluentCompactCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Width="24"
                                Height="24"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource App.PrimaryBrush}"
                                Symbol="PersonCircle24" />
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.TextPrimaryBrush}"
                                    Text="{Binding DisplayName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding DisplayName}" />
                                <TextBlock
                                    Margin="0,2,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                                    Text="{Binding EmployeeNumberText}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding EmployeeNumberText}" />
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </ui:NavigationView.PaneFooter>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem
                        AutomationProperties.Name="{Binding ThemeToggleText}"
                        Command="{Binding ToggleThemeCommand}"
                        Content="{Binding ThemeToggleText}"
                        Style="{StaticResource FluentNavigationItemStyle}"
                        ToolTip="{Binding ThemeToggleText}">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="DarkTheme24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>

                    <ui:NavigationViewItem
                        AutomationProperties.Name="Log out"
                        Command="{Binding LogoutCommand}"
                        Content="Log out"
                        Style="{StaticResource FluentNavigationItemStyle}"
                        ToolTip="Sign out and return to Login">
                        <ui:NavigationViewItem.Icon>
                            <ui:SymbolIcon Symbol="SignOut24" />
                        </ui:NavigationViewItem.Icon>
                    </ui:NavigationViewItem>
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <!-- Overview remains lightweight; feature data loads only when a workspace opens. -->
            <Grid Grid.Column="1" Background="{DynamicResource App.BackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="88" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Padding="30,0"
                    Background="{DynamicResource App.SurfaceBrush}"
                    BorderBrush="{DynamicResource App.DividerBrush}"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                AutomationProperties.HeadingLevel="Level1"
                                FontFamily="Segoe UI Variable Display, Segoe UI"
                                FontSize="26"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource App.TextPrimaryBrush}"
                                Text="{Binding WelcomeText}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                Text="{Binding ProfileSummaryText}" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Padding="11,6"
                            VerticalAlignment="Center"
                            Style="{StaticResource FluentGoodBadgeStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Width="17"
                                    Height="17"
                                    Margin="0,0,7,0"
                                    Foreground="{DynamicResource App.SuccessBrush}"
                                    Symbol="ShieldCheckmark24" />
                                <TextBlock FontWeight="SemiBold" Text="Authenticated" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="1160" Margin="30,26,30,36">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock
                                FontFamily="Segoe UI Variable Display, Segoe UI"
                                FontSize="32"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource App.TextPrimaryBrush}"
                                Text="Choose a workspace" />
                            <TextBlock
                                Margin="0,6,0,0"
                                MaxWidth="760"
                                FontSize="14"
                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                Text="Open one focused workspace at a time. Closing it returns you here without changing the authenticated session."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Grid.Row="2" Visibility="{Binding TraineeVisibility}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ui:Card
                                Grid.Column="0"
                                Background="{DynamicResource App.NavigationBrush}"
                                BorderBrush="{DynamicResource App.NavigationRaisedBrush}"
                                Style="{StaticResource FluentSurfaceCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="18" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <ui:SymbolIcon
                                            Width="34"
                                            Height="34"
                                            HorizontalAlignment="Left"
                                            Foreground="{DynamicResource App.SecondaryBrush}"
                                            Symbol="Target24" />
                                        <TextBlock
                                            Margin="0,17,0,0"
                                            FontFamily="Segoe UI Variable Display, Segoe UI"
                                            FontSize="24"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource App.DarkTextBrush}"
                                            Text="Inspection training" />
                                        <TextBlock
                                            Margin="0,7,0,0"
                                            MaxWidth="610"
                                            Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                                            Text="Choose a ten- or twenty-question session, inspect each production image, and classify it as GOOD or NG."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Row="2"
                                        MinWidth="176"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Open training setup from overview"
                                        Command="{Binding TrainingCommand}"
                                        Content="Open training"
                                        Icon="{ui:SymbolIcon ArrowRight24}"
                                        Style="{StaticResource FluentPrimaryButtonStyle}" />
                                </Grid>
                            </ui:Card>

                            <ui:Card Grid.Column="2" Style="{StaticResource FluentSurfaceCardStyle}">
                                <StackPanel>
                                    <ui:SymbolIcon
                                        Width="32"
                                        Height="32"
                                        HorizontalAlignment="Left"
                                        Foreground="{DynamicResource App.InfoBrush}"
                                        Symbol="DataTrending24" />
                                    <TextBlock
                                        Margin="0,16,0,0"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        Text="My progress" />
                                    <TextBlock
                                        Margin="0,6,0,18"
                                        Foreground="{DynamicResource App.TextSecondaryBrush}"
                                        Text="Explore personal activity, reviewed accuracy, review coverage, and completed-session details."
                                        TextWrapping="Wrap" />
                                    <ui:Button
                                        AutomationProperties.Name="Open personal progress from overview"
                                        Command="{Binding HistoryCommand}"
                                        Content="View progress"
                                        Icon="{ui:SymbolIcon ArrowRight24}"
                                        Style="{StaticResource FluentSecondaryButtonStyle}" />
                                </StackPanel>
                            </ui:Card>
                        </Grid>

                        <UniformGrid Grid.Row="2" Columns="2" Rows="2" Visibility="{Binding AdministratorVisibility}">
                            <ui:Card Margin="0,0,9,9" Style="{StaticResource FluentSurfaceCardStyle}">
                                <StackPanel>
                                    <ui:SymbolIcon Width="32" Height="32" HorizontalAlignment="Left" Foreground="{DynamicResource App.PrimaryBrush}" Symbol="ClipboardTask24" />
                                    <TextBlock Margin="0,14,0,0" FontSize="20" FontWeight="SemiBold" Text="Review workflow" />
                                    <TextBlock Margin="0,6,0,16" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Review trainee decisions and maintain reusable GOOD/NG truth." TextWrapping="Wrap" />
                                    <ui:Button Command="{Binding ReviewWorkflowCommand}" Content="Open review" Icon="{ui:SymbolIcon ArrowRight24}" Style="{StaticResource FluentSecondaryButtonStyle}" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="9,0,0,9" Style="{StaticResource FluentSurfaceCardStyle}">
                                <StackPanel>
                                    <ui:SymbolIcon Width="32" Height="32" HorizontalAlignment="Left" Foreground="{DynamicResource App.InfoBrush}" Symbol="DataTrending24" />
                                    <TextBlock Margin="0,14,0,0" FontSize="20" FontWeight="SemiBold" Text="Dashboard" />
                                    <TextBlock Margin="0,6,0,16" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Monitor daily metrics, trends, review coverage, and training time." TextWrapping="Wrap" />
                                    <ui:Button Command="{Binding DashboardCommand}" Content="Open dashboard" Icon="{ui:SymbolIcon ArrowRight24}" Style="{StaticResource FluentSecondaryButtonStyle}" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="0,9,9,0" Style="{StaticResource FluentSurfaceCardStyle}">
                                <StackPanel>
                                    <ui:SymbolIcon Width="32" Height="32" HorizontalAlignment="Left" Foreground="{DynamicResource App.SuccessBrush}" Symbol="DocumentData24" />
                                    <TextBlock Margin="0,14,0,0" FontSize="20" FontWeight="SemiBold" Text="Reports" />
                                    <TextBlock Margin="0,6,0,16" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Compare period charts and tables, then export verified report data." TextWrapping="Wrap" />
                                    <ui:Button Command="{Binding ReportsCommand}" Content="Open reports" Icon="{ui:SymbolIcon ArrowRight24}" Style="{StaticResource FluentSecondaryButtonStyle}" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="9,9,0,0" Style="{StaticResource FluentSurfaceCardStyle}">
                                <StackPanel>
                                    <ui:SymbolIcon Width="32" Height="32" HorizontalAlignment="Left" Foreground="{DynamicResource App.WarningBrush}" Symbol="PeopleTeam24" />
                                    <TextBlock Margin="0,14,0,0" FontSize="20" FontWeight="SemiBold" Text="User management" />
                                    <TextBlock Margin="0,6,0,16" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Create, activate, update, and secure authorized application accounts." TextWrapping="Wrap" />
                                    <ui:Button Command="{Binding UserManagementCommand}" Content="Manage users" Icon="{ui:SymbolIcon ArrowRight24}" Style="{StaticResource FluentSecondaryButtonStyle}" />
                                </StackPanel>
                            </ui:Card>
                        </UniformGrid>

                        <Border Grid.Row="4" Padding="16,13" Style="{StaticResource FluentStatusBadgeStyle}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Width="21"
                                    Height="21"
                                    Margin="0,0,11,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource App.PrimaryBrush}"
                                    Symbol="Info24" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                                    Text="GOOD and NG are trainee selections. Reviewed accuracy excludes every pending or unsupported administrator truth."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
