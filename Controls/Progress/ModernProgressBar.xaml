<UserControl
    x:Class="VisualInspectionTrainingSystem.Controls.Progress.ModernProgressBar"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="180"
    d:DesignWidth="420"
    Focusable="False"
    IsHitTestVisible="False"
    mc:Ignorable="d">

    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, ElementName=Root}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Border Padding="24" Background="{DynamicResource App.BusyScrimBrush}">
        <ui:Card
            MaxWidth="430"
            Padding="30,26"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.Name="Operation in progress"
            Style="{StaticResource FluentSurfaceCardStyle}">
            <StackPanel HorizontalAlignment="Center">
                <Grid Width="64" Height="64">
                    <Ellipse Fill="{DynamicResource App.InfoSurfaceBrush}" />
                    <ui:ProgressRing
                        Width="34"
                        Height="34"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Loading progress"
                        Foreground="{DynamicResource App.PrimaryBrush}"
                        IsIndeterminate="True" />
                </Grid>
                <TextBlock
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource App.TextPrimaryBrush}"
                    Text="{Binding Message, ElementName=Root}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource App.TextMutedBrush}"
                    Text="Please wait. This window can still be closed safely."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ui:Card>
    </Border>
</UserControl>
