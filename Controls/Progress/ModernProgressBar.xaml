<UserControl
    x:Class="VisualInspectionTrainingSystem.Controls.Progress.ModernProgressBar"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="180"
    d:DesignWidth="420"
    Focusable="False"
    IsHitTestVisible="False"
    mc:Ignorable="d">

    <UserControl.Style>
        <Style TargetType="{x:Type UserControl}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, ElementName=Root}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Border Padding="24" Background="{DynamicResource App.BusyScrimBrush}">
        <Border
            MaxWidth="430"
            Padding="30,26"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource App.SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource App.BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            materialDesign:ElevationAssist.Elevation="Dp12">
            <StackPanel HorizontalAlignment="Center">
                <Border Width="58" Height="58" HorizontalAlignment="Center" Background="{DynamicResource App.InfoSurfaceBrush}" CornerRadius="17">
                    <materialDesign:PackIcon
                        Width="29"
                        Height="29"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Operation in progress"
                        Foreground="{DynamicResource App.PrimaryBrush}"
                        Kind="ProgressClock" />
                </Border>
                <TextBlock
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource App.TextPrimaryBrush}"
                    Text="{Binding Message, ElementName=Root}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ProgressBar
                    Width="272"
                    Height="6"
                    Margin="0,18,0,0"
                    AutomationProperties.Name="Loading progress"
                    IsIndeterminate="True" />
                <TextBlock
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource App.TextMutedBrush}"
                    Text="Please wait. This window can still be closed safely."
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Border>
</UserControl>
