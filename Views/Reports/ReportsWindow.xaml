<mah:MetroWindow
    x:Class="VisualInspectionTrainingSystem.Views.Reports.ReportsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="clr-namespace:VisualInspectionTrainingSystem.Controls.Charts"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:progress="clr-namespace:VisualInspectionTrainingSystem.Controls.Progress"
    Title="Reports"
    Width="1400"
    Height="840"
    MinWidth="1000"
    MinHeight="660"
    AutomationProperties.Name="Training reports"
    Background="{DynamicResource App.BackgroundBrush}"
    KeyboardNavigation.TabNavigation="Cycle"
    WindowStartupLocation="CenterScreen">

    <mah:MetroWindow.Resources>
        <Style x:Key="ReportActionButtonStyle" BasedOn="{StaticResource DarkActionButtonStyle}" TargetType="Button">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="PeriodButtonStyle" BasedOn="{StaticResource SecondaryActionButtonStyle}" TargetType="Button">
            <Setter Property="MinWidth" Value="94" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,0" />
        </Style>
        <Style x:Key="ReportCardLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ReportCardValueStyle" BasedOn="{StaticResource MetricValueTextStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="28,0" Background="{DynamicResource App.NavigationBrush}" materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" VerticalAlignment="Center" Background="#24FFFFFF" CornerRadius="12">
                    <materialDesign:PackIcon Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Kind="ChartBoxOutline" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock AutomationProperties.HeadingLevel="Level1" FontSize="22" FontWeight="SemiBold" Foreground="White" Text="Training Reports" />
                    <StackPanel Margin="0,2,0,0" Orientation="Horizontal">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#A5F3FC" Text="{Binding ActivePeriodText}" />
                        <TextBlock Margin="10,0,0,0" FontSize="12" Foreground="#C7D2FE" Text="{Binding DateRangeText}" />
                    </StackPanel>
                </StackPanel>
                <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button AutomationProperties.Name="Refresh reports" Command="{Binding RefreshCommand}" Style="{StaticResource ReportActionButtonStyle}" ToolTip="Reload the selected report period">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Refresh" Style="{StaticResource AppIconStyle}" /><TextBlock Text="Refresh" /></StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Export report as CSV" Command="{Binding ExportCsvCommand}" Style="{StaticResource ReportActionButtonStyle}" ToolTip="Export all matching sessions as a CSV file">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileDelimitedOutline" Style="{StaticResource AppIconStyle}" /><TextBlock Text="CSV" /></StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Export report as Excel workbook" Command="{Binding ExportExcelCommand}" Style="{StaticResource ReportActionButtonStyle}" ToolTip="Export all matching sessions as an Excel workbook">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="MicrosoftExcel" Style="{StaticResource AppIconStyle}" /><TextBlock Text="Excel" /></StackPanel>
                    </Button>
                    <Button AutomationProperties.Name="Export report as PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource ReportActionButtonStyle}" ToolTip="Export all matching sessions as a PDF document">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FilePdfBox" Style="{StaticResource AppIconStyle}" /><TextBlock Text="PDF" /></StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,22,28,24" Style="{StaticResource ContentEntranceGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="18,14" Style="{StaticResource FilterBarStyle}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <materialDesign:PackIcon Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource App.PrimaryBrush}" Kind="CalendarRange" />
                        <TextBlock Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource App.TextPrimaryBrush}" Text="Custom range" />
                        <DatePicker AutomationProperties.Name="Report start date" Width="152" Margin="0,0,12,0" materialDesign:HintAssist.Hint="Start date" SelectedDate="{Binding StartDate, Mode=TwoWay}" TabIndex="0" ToolTip="Inclusive first date for the report" />
                        <DatePicker AutomationProperties.Name="Report end date" Width="152" Margin="0,0,14,0" materialDesign:HintAssist.Hint="End date" SelectedDate="{Binding EndDate, Mode=TwoWay}" TabIndex="1" ToolTip="Inclusive last date for the report" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SupportingTextStyle}" Text="Refresh applies these inclusive dates." />
                    </WrapPanel>
                    <WrapPanel Grid.Row="1" Margin="32,12,0,0">
                        <Button Command="{Binding TodayCommand}" Content="Today" Style="{StaticResource PeriodButtonStyle}" />
                        <Button Command="{Binding ThisWeekCommand}" Content="This Week" Style="{StaticResource PeriodButtonStyle}" />
                        <Button Command="{Binding LastSevenDaysCommand}" Content="Last 7 Days" Style="{StaticResource PeriodButtonStyle}" />
                        <Button Command="{Binding ThisMonthCommand}" Content="This Month" Style="{StaticResource PeriodButtonStyle}" />
                        <Button Command="{Binding AllDatesCommand}" Content="All Dates" Style="{StaticResource PeriodButtonStyle}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <UniformGrid Grid.Row="2" Margin="-4,0" Columns="8" Rows="1">
                <Border Margin="4,0" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Style="{StaticResource ReportCardLabelStyle}" Text="TOTAL SESSIONS" /><TextBlock Style="{StaticResource ReportCardValueStyle}" Text="{Binding SessionCountText}" /><TextBlock FontSize="9" Foreground="{DynamicResource App.TextMutedBrush}" Text="{Binding CompletedOpenSessionsText}" TextTrimming="CharacterEllipsis" /></StackPanel></Border>
                <Border Margin="4,0" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Style="{StaticResource ReportCardLabelStyle}" Text="TRAINEES" /><TextBlock Style="{StaticResource ReportCardValueStyle}" Text="{Binding TraineeCountText}" /></StackPanel></Border>
                <Border Margin="4,0" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Style="{StaticResource ReportCardLabelStyle}" Text="QUESTIONS" /><TextBlock Style="{StaticResource ReportCardValueStyle}" Text="{Binding TotalQuestionsText}" /></StackPanel></Border>
                <Border Margin="4,0" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Style="{StaticResource ReportCardLabelStyle}" Text="REVIEWED" /><TextBlock Foreground="{DynamicResource App.InfoBrush}" Style="{StaticResource ReportCardValueStyle}" Text="{Binding ReviewedAnswersText}" /></StackPanel></Border>
                <Border Margin="4,0" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Style="{StaticResource ReportCardLabelStyle}" Text="PENDING" /><TextBlock Foreground="{DynamicResource App.WarningBrush}" Style="{StaticResource ReportCardValueStyle}" Text="{Binding PendingAnswersText}" /></StackPanel></Border>
                <Border Margin="4,0" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Style="{StaticResource ReportCardLabelStyle}" Text="REVIEW RESULT" /><TextBlock FontSize="13" Style="{StaticResource ReportCardValueStyle}" Text="{Binding CorrectWrongText}" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Margin="4,0" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Style="{StaticResource ReportCardLabelStyle}" Text="ACCURACY" /><TextBlock Foreground="{DynamicResource App.SuccessBrush}" Style="{StaticResource ReportCardValueStyle}" Text="{Binding AverageAccuracyText}" /></StackPanel></Border>
                <Border Margin="4,0" Style="{StaticResource MetricCardStyle}"><StackPanel><TextBlock Style="{StaticResource ReportCardLabelStyle}" Text="FIRST / LAST" /><TextBlock FontSize="10" Style="{StaticResource ReportCardValueStyle}" Text="{Binding FirstLastSessionText}" TextWrapping="Wrap" /></StackPanel></Border>
            </UniformGrid>

            <Border Grid.Row="4" Padding="1" Style="{StaticResource SurfaceCardStyle}">
                <TabControl
                    AutomationProperties.Name="Report views"
                    materialDesign:ColorZoneAssist.Mode="PrimaryLight"
                    Style="{StaticResource MaterialDesignTabControl}">
                    <TabItem AutomationProperties.Name="Report charts" Header="Charts" Style="{StaticResource MaterialDesignTabItem}">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            PanningMode="Both"
                            VerticalScrollBarVisibility="Auto">
                            <charts:AnalyticsChartsPanel DataContext="{Binding Charts}" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem AutomationProperties.Name="Report session table" Header="Session Table" Style="{StaticResource MaterialDesignTabItem}">
                        <DataGrid
                            AutomationProperties.Name="Report sessions"
                            AutoGenerateColumns="False"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="True"
                            CanUserResizeColumns="True"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            IsReadOnly="True"
                            ItemsSource="{Binding Sessions}"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="72" Binding="{Binding SessionID}" Header="Session" />
                                <DataGridTextColumn Width="92" Binding="{Binding EmployeeNo}" Header="Employee" />
                                <DataGridTextColumn Width="150" Binding="{Binding FullName}" Header="Full Name" />
                                <DataGridTextColumn Width="115" Binding="{Binding Department}" Header="Department" />
                                <DataGridTextColumn Width="126" Binding="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Header="Start" />
                                <DataGridTextColumn Width="126" Binding="{Binding EndTime, StringFormat={}{0:yyyy-MM-dd HH:mm}, TargetNullValue=N/A}" Header="End" />
                                <DataGridTextColumn Width="80" Binding="{Binding Status}" Header="Status" />
                                <DataGridTextColumn Width="74" Binding="{Binding TotalQuestions}" Header="Questions" />
                                <DataGridTextColumn Width="66" Binding="{Binding CorrectAnswers}" Header="Correct" />
                                <DataGridTextColumn Width="62" Binding="{Binding WrongAnswers}" Header="Wrong" />
                                <DataGridTextColumn Width="66" Binding="{Binding PendingAnswers}" Header="Pending" />
                                <DataGridTextColumn Width="72" Binding="{Binding ReviewedAnswers}" Header="Reviewed" />
                                <DataGridTextColumn Width="78" Binding="{Binding ReviewedAccuracyText}" Header="Accuracy" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </Border>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock AutomationProperties.LiveSetting="Polite" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource App.WarningBrush}" FontSize="11" Text="{Binding EmptyStateText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource App.PrimaryBrush}" FontSize="11" FontWeight="SemiBold" Text="{Binding BusyStatusText}" />
                    <TextBlock Margin="20,3,0,0" HorizontalAlignment="Right" Style="{StaticResource SupportingTextStyle}" Text="{Binding DisplayLimitText}" />
                </StackPanel>
            </Grid>
        </Grid>

        <progress:ModernProgressBar Grid.RowSpan="2" Panel.ZIndex="100" IsActive="{Binding IsBusy}" Message="{Binding BusyStatusText}" />
    </Grid>
</mah:MetroWindow>
