<Window
    x:Class="VisualInspectionTrainingSystem.Views.Admin.AdminWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:progress="clr-namespace:VisualInspectionTrainingSystem.Controls.Progress"
    Title="Administration - Review Workflow"
    Width="1480"
    Height="860"
    MinWidth="980"
    MinHeight="620"
    AutomationProperties.Name="Administrator review workflow"
    Background="{DynamicResource App.BackgroundBrush}"
    FontFamily="Segoe UI"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ActionButton" BasedOn="{StaticResource DarkActionButtonStyle}" TargetType="Button">
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SummaryBorder" BasedOn="{StaticResource MetricCardStyle}" TargetType="Border">
            <Setter Property="MinHeight" Value="88" />
            <Setter Property="Padding" Value="16" />
        </Style>
    </Window.Resources>

    <Grid Margin="22" Style="{StaticResource ContentEntranceGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="16" />
            <RowDefinition Height="112" />
            <RowDefinition Height="16" />
            <RowDefinition Height="92" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="16" />
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="22,12"
            Background="{DynamicResource App.NavigationBrush}"
            BorderBrush="{DynamicResource App.NavigationRaisedBrush}"
            BorderThickness="1"
            CornerRadius="18"
            materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="118" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level1"
                        FontSize="25"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource App.DarkTextBrush}"
                        Text="Administrator Review Workflow"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                        Text="{Binding FilterSummary}" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Open Dashboard"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding OpenDashboardCommand}"
                    ToolTip="Open daily training analytics">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ViewDashboardOutline" Style="{StaticResource AppIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="Dashboard" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Open Reports"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding OpenReportsCommand}"
                    ToolTip="Open reports and exports">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileChartOutline" Style="{StaticResource AppIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="Reports" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="5"
                    AutomationProperties.Name="Open User Management"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding OpenUserManagementCommand}"
                    ToolTip="Manage user access and activation">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountCogOutline" Style="{StaticResource AppIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="User Management" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="7"
                    AutomationProperties.Name="Refresh review workflow"
                    Style="{StaticResource ActionButton}"
                    Background="{DynamicResource App.PrimaryBrush}"
                    BorderBrush="{DynamicResource App.SecondaryBrush}"
                    Command="{Binding RefreshCommand}"
                    ToolTip="Reload review data">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Style="{StaticResource AppIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="9"
                    AutomationProperties.Name="Log out"
                    Style="{StaticResource ActionButton}"
                    Background="{DynamicResource App.DangerBrush}"
                    BorderBrush="{DynamicResource App.DangerSurfaceBrush}"
                    Command="{Binding LogoutCommand}"
                    ToolTip="Return to Login">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Logout" Style="{StaticResource AppIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="Logout" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Padding="16"
            Style="{StaticResource FilterBarStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.ColumnSpan="5"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                    Text="SEARCH EMPLOYEE, ANSWER, SESSION, FILE, HASH, USER ANSWER, OR TRUTH" />
                <TextBlock
                    Grid.Column="6"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                    Text="FILTER" />

                <TextBox
                    Grid.Row="2"
                    Grid.Column="0"
                    AutomationProperties.Name="Search review answers"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Search by employee, session, image identity, or answer value" />
                <Button
                    Grid.Row="2"
                    Grid.Column="2"
                    Style="{StaticResource ActionButton}"
                    Background="{DynamicResource App.PrimaryBrush}"
                    BorderBrush="{DynamicResource App.SecondaryBrush}"
                    Command="{Binding SearchCommand}"
                    Content="Search" />
                <Button
                    Grid.Row="2"
                    Grid.Column="4"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding ClearSearchCommand}"
                    Content="Clear" />
                <ComboBox
                    Grid.Row="2"
                    Grid.Column="6"
                    AutomationProperties.Name="Review answer filter"
                    ItemsSource="{Binding FilterOptions}"
                    SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" />
                <Button
                    Grid.Row="2"
                    Grid.Column="8"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding SelectVisibleCommand}"
                    Content="Select Visible" />
                <Button
                    Grid.Row="2"
                    Grid.Column="10"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding ClearSelectionCommand}"
                    Content="Clear Selection" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="12"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource App.TextPrimaryBrush}"
                    Text="{Binding SelectionSummary}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SummaryBorder}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}" Text="TOTAL ANSWERS" />
                    <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding TotalAnswers}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SummaryBorder}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}" Text="PENDING" />
                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="{DynamicResource App.WarningBrush}" Text="{Binding PendingAnswers}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource SummaryBorder}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}" Text="REVIEWED" />
                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="{DynamicResource App.SuccessBrush}" Text="{Binding ReviewedAnswers}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource SummaryBorder}">
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}" Text="VISIBLE / SELECTED" />
                    <TextBlock FontSize="28" FontWeight="Bold" Foreground="{DynamicResource App.PrimaryBrush}">
                        <Run Text="{Binding VisibleAnswers, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="16"
                Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource App.TextPrimaryBrush}"
                        Text="Answer Review Queue" />
                    <DataGrid
                        AutomationProperties.Name="Review answer queue"
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="True"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        ColumnHeaderHeight="36"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding Answers}"
                        MinRowHeight="40"
                        SelectedItem="{Binding SelectedAnswer, Mode=TwoWay}"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="46" Header="Pick">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="68" IsReadOnly="True" Binding="{Binding AnswerID}" Header="Answer" />
                            <DataGridTextColumn Width="68" IsReadOnly="True" Binding="{Binding SessionID}" Header="Session" />
                            <DataGridTextColumn Width="90" IsReadOnly="True" Binding="{Binding EmployeeNo}" Header="Employee" />
                            <DataGridTextColumn Width="130" IsReadOnly="True" Binding="{Binding FileName}" Header="File" />
                            <DataGridTextColumn Width="105" IsReadOnly="True" Binding="{Binding ShortImageHash}" Header="Image Hash" />
                            <DataGridTextColumn Width="72" IsReadOnly="True" Binding="{Binding UserAnswerText}" Header="User" />
                            <DataGridTextColumn Width="76" IsReadOnly="True" Binding="{Binding CorrectAnswerText}" Header="Truth" />
                            <DataGridTextColumn Width="80" IsReadOnly="True" Binding="{Binding ResultText}" Header="Result" />
                            <DataGridTextColumn Width="*" IsReadOnly="True" Binding="{Binding ReviewStatusText}" Header="Review Source" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="18"
                Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="220" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource App.TextPrimaryBrush}"
                        Text="{Binding SelectedImageCaption}" />
                    <Border
                        Grid.Row="1"
                        Margin="0,12,0,10"
                        Background="{DynamicResource App.DarkBackgroundBrush}"
                        BorderBrush="{DynamicResource App.BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Image AutomationProperties.Name="Selected inspection image preview" Source="{Binding SelectedImage}" Stretch="Uniform" />
                    </Border>
                    <TextBlock
                        Grid.Row="2"
                        Foreground="{DynamicResource App.TextSecondaryBrush}"
                        Text="{Binding SelectedImageStatus}"
                        TextWrapping="Wrap" />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}" Text="User answer" />
                        <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="{DynamicResource App.TextPrimaryBrush}" Text="{Binding SelectedUserAnswerText}" />
                        <TextBlock Grid.Row="1" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Admin truth" />
                        <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="Bold" Foreground="{DynamicResource App.WarningBrush}" Text="{Binding SelectedCorrectAnswerText}" />
                        <TextBlock Grid.Row="2" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Result" />
                        <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="Bold" Foreground="{DynamicResource App.TextPrimaryBrush}" Text="{Binding SelectedIsCorrectText}" />
                        <TextBlock Grid.Row="3" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Answered" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource App.TextPrimaryBrush}" Text="{Binding SelectedAnswerTimeText}" />
                        <TextBlock Grid.Row="4" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Review state" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource App.InfoBrush}" Text="{Binding SelectedReviewStatusText}" TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="8"
            Padding="16"
            Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="14"
                        Foreground="{DynamicResource App.TextPrimaryBrush}"
                        Text="{Binding StatusMessage}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Foreground="{DynamicResource App.TextSecondaryBrush}"
                        Text="Stable SHA-256 identity controls reuse; ImageID remains display-only." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Mark selected answer GOOD"
                    Style="{StaticResource ActionButton}"
                    Background="{DynamicResource App.SuccessBrush}"
                    BorderBrush="{DynamicResource App.SuccessBrush}"
                    Command="{Binding MarkGoodCommand}"
                    Content="Selected = GOOD" />
                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Mark selected answer NG"
                    Style="{StaticResource ActionButton}"
                    Background="{DynamicResource App.DangerBrush}"
                    BorderBrush="{DynamicResource App.DangerBrush}"
                    Command="{Binding MarkNgCommand}"
                    Content="Selected = NG" />
                <Button
                    Grid.Column="5"
                    AutomationProperties.Name="Bulk review selected answers as GOOD"
                    Style="{StaticResource ActionButton}"
                    Background="{DynamicResource App.SuccessBrush}"
                    BorderBrush="{DynamicResource App.SuccessBrush}"
                    Command="{Binding BulkGoodCommand}"
                    Content="Bulk GOOD" />
                <Button
                    Grid.Column="7"
                    AutomationProperties.Name="Bulk review selected answers as NG"
                    Style="{StaticResource ActionButton}"
                    Background="{DynamicResource App.DangerBrush}"
                    BorderBrush="{DynamicResource App.DangerBrush}"
                    Command="{Binding BulkNgCommand}"
                    Content="Bulk NG" />
            </Grid>
        </Border>

        <progress:ModernProgressBar
            Grid.RowSpan="9"
            Panel.ZIndex="100"
            IsActive="{Binding IsBusy}"
            Message="{Binding StatusMessage}" />
    </Grid>
</Window>
