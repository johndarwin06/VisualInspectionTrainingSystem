<ui:FluentWindow
    x:Class="VisualInspectionTrainingSystem.Views.Admin.AdminWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="Review Workflow"
    Width="1480"
    Height="880"
    MinWidth="1040"
    MinHeight="660"
    AutomationProperties.Name="Administrator review workflow"
    ExtendsContentIntoTitleBar="True"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    Style="{StaticResource FluentAppWindowStyle}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Panel.ZIndex="30"
            Icon="{ui:SymbolIcon ClipboardTask24}"
            Style="{StaticResource FluentAppTitleBarStyle}"
            Title="Review Workflow" />

        <vio:BusyMask
            Grid.Row="1"
            BusyContent="{Binding StatusMessage}"
            BusyContentMargin="0,14,0,0"
            IsBusy="{Binding IsBusy}">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Compact Fluent command bar. -->
                <ui:Card
                    Grid.Row="0"
                    Background="{DynamicResource App.NavigationBrush}"
                    BorderBrush="{DynamicResource App.NavigationRaisedBrush}"
                    Style="{StaticResource FluentCompactCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Width="26"
                                    Height="26"
                                    Margin="0,0,11,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource App.SecondaryBrush}"
                                    Symbol="ClipboardTask24" />
                                <TextBlock
                                    AutomationProperties.ItemType="Heading"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI Variable Display, Segoe UI"
                                    FontSize="24"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.DarkTextBrush}"
                                    Text="Review Workflow" />
                            </StackPanel>
                            <TextBlock
                                Margin="37,3,12,0"
                                FontSize="12"
                                Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                                Text="{Binding FilterSummary}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding FilterSummary}" />
                        </StackPanel>

                        <ui:Button
                            Grid.Column="1"
                            AutomationProperties.Name="Refresh review workflow"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh"
                            Icon="{ui:SymbolIcon ArrowClockwise24}"
                            Style="{StaticResource FluentPrimaryButtonStyle}"
                            ToolTip="Reload review data" />
                    </Grid>
                </ui:Card>

                <!-- Search, filtering, and multi-selection commands remain ViewModel driven. -->
                <ui:Card Grid.Row="2" Style="{StaticResource FluentCompactCardStyle}">
                    <WrapPanel Margin="-4">
                        <ui:TextBox
                            Width="330"
                            Margin="4"
                            AutomationProperties.Name="Search review answers"
                            ClearButtonEnabled="True"
                            Icon="{ui:SymbolIcon Search24}"
                            PlaceholderText="Search employee, session, file, hash, answer, or truth"
                            Style="{StaticResource FluentTextBoxStyle}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Search by employee, session, image identity, or answer value" />
                        <ui:Button
                            Margin="4"
                            AutomationProperties.Name="Search review answers"
                            Command="{Binding SearchCommand}"
                            Content="Search"
                            Icon="{ui:SymbolIcon Search24}"
                            Style="{StaticResource FluentToolbarButtonStyle}" />
                        <ui:Button
                            Margin="4"
                            AutomationProperties.Name="Clear review search"
                            Command="{Binding ClearSearchCommand}"
                            Content="Clear"
                            Icon="{ui:SymbolIcon Dismiss20}"
                            Style="{StaticResource FluentToolbarButtonStyle}" />
                        <StackPanel Width="220" Margin="4,0">
                            <TextBlock
                                Margin="2,0,0,3"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                Text="REVIEW FILTER" />
                            <ComboBox
                                AutomationProperties.Name="Review answer filter"
                                ItemsSource="{Binding FilterOptions}"
                                SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                                Style="{StaticResource FluentComboBoxStyle}" />
                        </StackPanel>
                        <ui:Button
                            Margin="4"
                            AutomationProperties.Name="Select visible answers"
                            Command="{Binding SelectVisibleCommand}"
                            Content="Select visible"
                            Icon="{ui:SymbolIcon SelectAllOn24}"
                            Style="{StaticResource FluentToolbarButtonStyle}" />
                        <ui:Button
                            Margin="4"
                            AutomationProperties.Name="Clear selected answers"
                            Command="{Binding ClearSelectionCommand}"
                            Content="Clear selection"
                            Icon="{ui:SymbolIcon SelectAllOff24}"
                            Style="{StaticResource FluentToolbarButtonStyle}" />
                        <Border
                            MinWidth="220"
                            MinHeight="40"
                            Margin="4"
                            VerticalAlignment="Center"
                            Style="{StaticResource FluentStatusBadgeStyle}">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{Binding SelectionSummary}"
                                TextWrapping="Wrap" />
                        </Border>
                    </WrapPanel>
                </ui:Card>

                <!-- Daily queue summary. -->
                <UniformGrid Grid.Row="4" Margin="-4,0" Columns="4" Rows="1">
                    <ui:Card MinHeight="78" Margin="4,0" Style="{StaticResource FluentCompactCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="TOTAL ANSWERS" />
                            <TextBlock Margin="0,5,0,0" FontSize="27" FontWeight="SemiBold" Text="{Binding TotalAnswers}" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card MinHeight="78" Margin="4,0" Style="{StaticResource FluentCompactCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="PENDING" />
                            <TextBlock Margin="0,5,0,0" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource App.WarningBrush}" Text="{Binding PendingAnswers}" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card MinHeight="78" Margin="4,0" Style="{StaticResource FluentCompactCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="REVIEWED" />
                            <TextBlock Margin="0,5,0,0" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource App.SuccessBrush}" Text="{Binding ReviewedAnswers}" />
                        </StackPanel>
                    </ui:Card>
                    <ui:Card MinHeight="78" Margin="4,0" Style="{StaticResource FluentCompactCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="VISIBLE / SELECTED" />
                            <TextBlock Margin="0,5,0,0" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource App.PrimaryBrush}">
                                <Run Text="{Binding VisibleAnswers, Mode=OneWay}" />
                                <Run Text=" / " />
                                <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </ui:Card>
                </UniformGrid>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" MinWidth="590" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <!-- WPF-UI DataGrid preserves native sorting, selection, and virtualization. -->
                    <ui:Card Grid.Column="0" Style="{StaticResource FluentCompactCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    AutomationProperties.ItemType="Heading"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="Answer review queue" />
                                <Border Grid.Column="1" Style="{StaticResource FluentPendingBadgeStyle}">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.InfoBrush}" Text="{Binding ActiveFilter}" />
                                </Border>
                            </Grid>

                            <ui:DataGrid
                                Grid.Row="2"
                                AutomationProperties.Name="Review answer queue"
                                AutoGenerateColumns="False"
                                ColumnHeaderHeight="38"
                                ItemsSource="{Binding Answers}"
                                SelectedItem="{Binding SelectedAnswer, Mode=TwoWay}"
                                Style="{StaticResource FluentDataGridStyle}">
                                <ui:DataGrid.Columns>
                                    <DataGridTemplateColumn Width="48" Header="Pick">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource DefaultCheckBoxStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="68" IsReadOnly="True" Binding="{Binding AnswerID}" Header="Answer" />
                                    <DataGridTextColumn Width="68" IsReadOnly="True" Binding="{Binding SessionID}" Header="Session" />
                                    <DataGridTextColumn Width="90" IsReadOnly="True" Binding="{Binding EmployeeNo}" Header="Employee" />
                                    <DataGridTextColumn Width="130" IsReadOnly="True" Binding="{Binding FileName}" Header="File" />
                                    <DataGridTextColumn Width="105" IsReadOnly="True" Binding="{Binding ShortImageHash}" Header="Image hash" />
                                    <DataGridTemplateColumn Width="92" IsReadOnly="True" Header="User">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Margin="4">
                                                    <Border.Style>
                                                        <Style BasedOn="{StaticResource FluentStatusBadgeStyle}" TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UserAnswerText}" Value="GOOD">
                                                                    <Setter Property="Background" Value="{DynamicResource App.SuccessSurfaceBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding UserAnswerText}" Value="NG">
                                                                    <Setter Property="Background" Value="{DynamicResource App.WarningSurfaceBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding UserAnswerText}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="96" IsReadOnly="True" Header="Truth">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Margin="4">
                                                    <Border.Style>
                                                        <Style BasedOn="{StaticResource FluentPendingBadgeStyle}" TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CorrectAnswerText}" Value="GOOD">
                                                                    <Setter Property="Background" Value="{DynamicResource App.SuccessSurfaceBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding CorrectAnswerText}" Value="NG">
                                                                    <Setter Property="Background" Value="{DynamicResource App.WarningSurfaceBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.WarningBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding CorrectAnswerText}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="110" IsReadOnly="True" Header="Result">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Margin="4">
                                                    <Border.Style>
                                                        <Style BasedOn="{StaticResource FluentPendingBadgeStyle}" TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ResultText}" Value="Correct">
                                                                    <Setter Property="Background" Value="{DynamicResource App.SuccessSurfaceBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ResultText}" Value="Wrong">
                                                                    <Setter Property="Background" Value="{DynamicResource App.DangerSurfaceBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding ResultText}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="*" IsReadOnly="True" Binding="{Binding ReviewStatusText}" Header="Review source" />
                                </ui:DataGrid.Columns>
                            </ui:DataGrid>
                        </Grid>
                    </ui:Card>

                    <!-- Selected-answer preview and details. -->
                    <ui:Card Grid.Column="2" Style="{StaticResource FluentCompactCardStyle}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="190" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    AutomationProperties.ItemType="Heading"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="{Binding SelectedImageCaption}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding SelectedImageCaption}" />
                                <Border
                                    Grid.Row="1"
                                    Margin="0,10,0,9"
                                    Background="{DynamicResource App.DarkBackgroundBrush}"
                                    BorderBrush="{DynamicResource App.BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Image AutomationProperties.Name="Selected inspection image preview" Source="{Binding SelectedImage}" Stretch="Uniform" />
                                </Border>
                                <TextBlock
                                    Grid.Row="2"
                                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                                    Text="{Binding SelectedImageStatus}"
                                    TextWrapping="Wrap" />
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}" Text="User answer" />
                                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding SelectedUserAnswerText}" />
                                    <TextBlock Grid.Row="1" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Admin truth" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource App.WarningBrush}" Text="{Binding SelectedCorrectAnswerText}" />
                                    <TextBlock Grid.Row="2" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Result" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="SemiBold" Text="{Binding SelectedIsCorrectText}" />
                                    <TextBlock Grid.Row="3" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Answered" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedAnswerTimeText}" />
                                    <TextBlock Grid.Row="4" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Review state" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource App.InfoBrush}" Text="{Binding SelectedReviewStatusText}" TextWrapping="Wrap" />
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </ui:Card>
                </Grid>

                <!-- Review commands distinguish classification NG from correctness Wrong. -->
                <ui:Card Grid.Row="8" Style="{StaticResource FluentCompactCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                AutomationProperties.ItemType="Status"
                                FontSize="13"
                                Text="{Binding StatusMessage}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding StatusMessage}" />
                            <TextBlock
                                Margin="0,3,12,0"
                                FontSize="11"
                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                Text="Stable SHA-256 identity controls reuse; ImageID remains display-only."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <WrapPanel Grid.Column="1" Margin="8,-4,-4,-4" HorizontalAlignment="Right">
                            <ui:Button
                                Margin="4"
                                AutomationProperties.Name="Mark selected answer GOOD"
                                Appearance="Success"
                                Command="{Binding MarkGoodCommand}"
                                Content="Selected = GOOD"
                                Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                Style="{StaticResource FluentSecondaryButtonStyle}" />
                            <ui:Button
                                Margin="4"
                                AutomationProperties.Name="Mark selected answer NG"
                                Appearance="Caution"
                                Command="{Binding MarkNgCommand}"
                                Content="Selected = NG"
                                Icon="{ui:SymbolIcon DismissCircle24}"
                                Style="{StaticResource FluentSecondaryButtonStyle}" />
                            <ui:Button
                                Margin="4"
                                AutomationProperties.Name="Bulk review selected answers as GOOD"
                                Appearance="Success"
                                Command="{Binding BulkGoodCommand}"
                                Content="Bulk GOOD"
                                Icon="{ui:SymbolIcon CheckmarkCircle24}"
                                Style="{StaticResource FluentSecondaryButtonStyle}" />
                            <ui:Button
                                Margin="4"
                                AutomationProperties.Name="Bulk review selected answers as NG"
                                Appearance="Caution"
                                Command="{Binding BulkNgCommand}"
                                Content="Bulk NG"
                                Icon="{ui:SymbolIcon DismissCircle24}"
                                Style="{StaticResource FluentSecondaryButtonStyle}" />
                        </WrapPanel>
                    </Grid>
                </ui:Card>
            </Grid>
        </vio:BusyMask>
    </Grid>
</ui:FluentWindow>
