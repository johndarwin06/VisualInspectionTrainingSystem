<mah:MetroWindow
    x:Class="VisualInspectionTrainingSystem.Views.Admin.AdminWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:progress="clr-namespace:VisualInspectionTrainingSystem.Controls.Progress"
    Title="Review Workflow"
    Width="1480"
    Height="860"
    MinWidth="980"
    MinHeight="620"
    AutomationProperties.Name="Administrator review workflow"
    Background="{DynamicResource App.BackgroundBrush}"
    BorderBrush="{DynamicResource App.BorderBrush}"
    FontFamily="Segoe UI"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">

    <mah:MetroWindow.Resources>
        <Style x:Key="ActionButton" BasedOn="{StaticResource DarkActionButtonStyle}" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SummaryBorder" BasedOn="{StaticResource MetricCardStyle}" TargetType="Border">
            <Setter Property="MinHeight" Value="78" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="SummaryLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
        </Style>
    </mah:MetroWindow.Resources>

    <Grid Margin="18" Style="{StaticResource ContentEntranceGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="20,13"
            Background="{DynamicResource App.NavigationBrush}"
            BorderBrush="{DynamicResource App.NavigationRaisedBrush}"
            BorderThickness="1"
            CornerRadius="16"
            materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="27"
                            Height="27"
                            Margin="0,0,11,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource App.SecondaryBrush}"
                            Kind="ClipboardCheckOutline" />
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            VerticalAlignment="Center"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.DarkTextBrush}"
                            Text="Review Workflow" />
                    </StackPanel>
                    <TextBlock
                        Margin="38,3,12,0"
                        FontSize="12"
                        Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                        Text="{Binding FilterSummary}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="Refresh review workflow"
                    Background="{DynamicResource App.PrimaryBrush}"
                    BorderBrush="{DynamicResource App.SecondaryBrush}"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource ActionButton}"
                    ToolTip="Reload review data">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Style="{StaticResource AppIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Padding="12" Style="{StaticResource FilterBarStyle}">
            <WrapPanel Margin="-4">
                <TextBox
                    AutomationProperties.Name="Search review answers"
                    Width="330"
                    MinHeight="40"
                    Margin="4"
                    VerticalContentAlignment="Center"
                    materialDesign:HintAssist.Hint="Search employee, session, file, hash, answer, or truth"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Search by employee, session, image identity, or answer value" />
                <Button
                    AutomationProperties.Name="Search review answers"
                    Background="{DynamicResource App.PrimaryBrush}"
                    BorderBrush="{DynamicResource App.SecondaryBrush}"
                    Command="{Binding SearchCommand}"
                    Content="Search"
                    Style="{StaticResource ActionButton}" />
                <Button
                    AutomationProperties.Name="Clear review search"
                    Command="{Binding ClearSearchCommand}"
                    Content="Clear"
                    Style="{StaticResource ActionButton}" />
                <ComboBox
                    AutomationProperties.Name="Review answer filter"
                    Width="220"
                    MinHeight="40"
                    Margin="4"
                    materialDesign:HintAssist.Hint="Review filter"
                    ItemsSource="{Binding FilterOptions}"
                    SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" />
                <Button
                    AutomationProperties.Name="Select visible answers"
                    Command="{Binding SelectVisibleCommand}"
                    Content="Select Visible"
                    Style="{StaticResource ActionButton}" />
                <Button
                    AutomationProperties.Name="Clear selected answers"
                    Command="{Binding ClearSelectionCommand}"
                    Content="Clear Selection"
                    Style="{StaticResource ActionButton}" />
                <Border
                    MinWidth="220"
                    MinHeight="40"
                    Margin="4"
                    Padding="12,7"
                    VerticalAlignment="Center"
                    Background="{DynamicResource App.SurfaceVariantBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource App.TextPrimaryBrush}"
                        Text="{Binding SelectionSummary}"
                        TextWrapping="Wrap" />
                </Border>
            </WrapPanel>
        </Border>

        <UniformGrid Grid.Row="4" Margin="-4,0" Columns="4" Rows="1">
            <Border Style="{StaticResource SummaryBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SummaryLabel}" Text="TOTAL ANSWERS" />
                    <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding TotalAnswers}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SummaryLabel}" Text="PENDING" />
                    <TextBlock FontSize="27" FontWeight="Bold" Foreground="{DynamicResource App.WarningBrush}" Text="{Binding PendingAnswers}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SummaryLabel}" Text="REVIEWED" />
                    <TextBlock FontSize="27" FontWeight="Bold" Foreground="{DynamicResource App.SuccessBrush}" Text="{Binding ReviewedAnswers}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SummaryBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SummaryLabel}" Text="VISIBLE / SELECTED" />
                    <TextBlock FontSize="27" FontWeight="Bold" Foreground="{DynamicResource App.PrimaryBrush}">
                        <Run Text="{Binding VisibleAnswers, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" MinWidth="560" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="14" Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            VerticalAlignment="Center"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.TextPrimaryBrush}"
                            Text="Answer Review Queue" />
                        <Border
                            Grid.Column="1"
                            Padding="10,4"
                            Background="{DynamicResource App.InfoSurfaceBrush}"
                            CornerRadius="10">
                            <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.InfoBrush}" Text="{Binding ActiveFilter}" />
                        </Border>
                    </Grid>

                    <DataGrid
                        Grid.Row="2"
                        AutomationProperties.Name="Review answer queue"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="True"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        ColumnHeaderHeight="36"
                        EnableColumnVirtualization="True"
                        EnableRowVirtualization="True"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding Answers}"
                        MinRowHeight="40"
                        SelectedItem="{Binding SelectedAnswer, Mode=TwoWay}"
                        SelectionMode="Single"
                        SelectionUnit="FullRow"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="46" Header="Pick">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="68" IsReadOnly="True" Binding="{Binding AnswerID}" Header="Answer" />
                            <DataGridTextColumn Width="68" IsReadOnly="True" Binding="{Binding SessionID}" Header="Session" />
                            <DataGridTextColumn Width="90" IsReadOnly="True" Binding="{Binding EmployeeNo}" Header="Employee" />
                            <DataGridTextColumn Width="130" IsReadOnly="True" Binding="{Binding FileName}" Header="File" />
                            <DataGridTextColumn Width="105" IsReadOnly="True" Binding="{Binding ShortImageHash}" Header="Image Hash" />
                            <DataGridTemplateColumn Width="92" IsReadOnly="True" Header="User">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="4">
                                            <Border.Style>
                                                <Style BasedOn="{StaticResource StatusChipStyle}" TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UserAnswerText}" Value="GOOD"><Setter Property="Background" Value="{DynamicResource App.SuccessSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource App.SuccessBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding UserAnswerText}" Value="NG"><Setter Property="Background" Value="{DynamicResource App.DangerSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding UserAnswerText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="96" IsReadOnly="True" Header="Truth">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="4">
                                            <Border.Style>
                                                <Style BasedOn="{StaticResource PendingChipStyle}" TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CorrectAnswerText}" Value="GOOD"><Setter Property="Background" Value="{DynamicResource App.SuccessSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource App.SuccessBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding CorrectAnswerText}" Value="NG"><Setter Property="Background" Value="{DynamicResource App.DangerSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding CorrectAnswerText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="110" IsReadOnly="True" Header="Result">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="4">
                                            <Border.Style>
                                                <Style BasedOn="{StaticResource PendingChipStyle}" TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResultText}" Value="Correct"><Setter Property="Background" Value="{DynamicResource App.SuccessSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource App.SuccessBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ResultText}" Value="Wrong"><Setter Property="Background" Value="{DynamicResource App.DangerSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="{Binding ResultText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="*" IsReadOnly="True" Binding="{Binding ReviewStatusText}" Header="Review Source" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="16" Style="{StaticResource SurfaceCardStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="180" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.TextPrimaryBrush}"
                            Text="{Binding SelectedImageCaption}"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Grid.Row="1"
                            Margin="0,10,0,9"
                            Background="{DynamicResource App.DarkBackgroundBrush}"
                            BorderBrush="{DynamicResource App.BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Image AutomationProperties.Name="Selected inspection image preview" Source="{Binding SelectedImage}" Stretch="Uniform" />
                        </Border>
                        <TextBlock
                            Grid.Row="2"
                            Foreground="{DynamicResource App.TextSecondaryBrush}"
                            Text="{Binding SelectedImageStatus}"
                            TextWrapping="Wrap" />
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}" Text="User answer" />
                            <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="{DynamicResource App.TextPrimaryBrush}" Text="{Binding SelectedUserAnswerText}" />
                            <TextBlock Grid.Row="1" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Admin truth" />
                            <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="Bold" Foreground="{DynamicResource App.WarningBrush}" Text="{Binding SelectedCorrectAnswerText}" />
                            <TextBlock Grid.Row="2" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Result" />
                            <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="Bold" Foreground="{DynamicResource App.TextPrimaryBrush}" Text="{Binding SelectedIsCorrectText}" />
                            <TextBlock Grid.Row="3" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Answered" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Foreground="{DynamicResource App.TextPrimaryBrush}" Text="{Binding SelectedAnswerTimeText}" />
                            <TextBlock Grid.Row="4" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Review state" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Foreground="{DynamicResource App.InfoBrush}" Text="{Binding SelectedReviewStatusText}" TextWrapping="Wrap" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="8" Padding="12" Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            AutomationProperties.LiveSetting="Polite"
                            FontSize="13"
                            Foreground="{DynamicResource App.TextPrimaryBrush}"
                            Text="{Binding StatusMessage}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,3,12,0"
                            FontSize="11"
                            Foreground="{DynamicResource App.TextSecondaryBrush}"
                            Text="Stable SHA-256 identity controls reuse; ImageID remains display-only."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource App.TextSecondaryBrush}"
                        Text="Selected row actions"
                        TextWrapping="Wrap" />
                </Grid>

                <WrapPanel Grid.Row="1" Margin="-4,4,-4,-4" HorizontalAlignment="Right">
                    <Button
                        AutomationProperties.Name="Mark selected answer GOOD"
                        Background="{DynamicResource App.SuccessBrush}"
                        BorderBrush="{DynamicResource App.SuccessBrush}"
                        Command="{Binding MarkGoodCommand}"
                        Content="Selected = GOOD"
                        Style="{StaticResource ActionButton}" />
                    <Button
                        AutomationProperties.Name="Mark selected answer NG"
                        Background="{DynamicResource App.DangerBrush}"
                        BorderBrush="{DynamicResource App.DangerBrush}"
                        Command="{Binding MarkNgCommand}"
                        Content="Selected = NG"
                        Style="{StaticResource ActionButton}" />
                    <Button
                        AutomationProperties.Name="Bulk review selected answers as GOOD"
                        Background="{DynamicResource App.SuccessBrush}"
                        BorderBrush="{DynamicResource App.SuccessBrush}"
                        Command="{Binding BulkGoodCommand}"
                        Content="Bulk GOOD"
                        Style="{StaticResource ActionButton}" />
                    <Button
                        AutomationProperties.Name="Bulk review selected answers as NG"
                        Background="{DynamicResource App.DangerBrush}"
                        BorderBrush="{DynamicResource App.DangerBrush}"
                        Command="{Binding BulkNgCommand}"
                        Content="Bulk NG"
                        Style="{StaticResource ActionButton}" />
                </WrapPanel>
            </Grid>
        </Border>

        <progress:ModernProgressBar
            Grid.RowSpan="9"
            Panel.ZIndex="100"
            IsActive="{Binding IsBusy}"
            Message="{Binding StatusMessage}" />
    </Grid>
</mah:MetroWindow>
