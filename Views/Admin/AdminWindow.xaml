<Window
    x:Class="VisualInspectionTrainingSystem.Views.Admin.AdminWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Administration - Review Workflow"
    Width="1480"
    Height="860"
    MinWidth="1180"
    MinHeight="720"
    Background="#0F1720"
    FontFamily="Segoe UI"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#1F2937" />
            <Setter Property="BorderBrush" Value="#4B5563" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SummaryBorder" TargetType="Border">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="#17212B" />
            <Setter Property="BorderBrush" Value="#2D4050" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="#0F1720" />
            <Setter Property="BorderBrush" Value="#4B5563" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="CaretBrush" Value="#F8FAFC" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="74" />
            <RowDefinition Height="12" />
            <RowDefinition Height="104" />
            <RowDefinition Height="12" />
            <RowDefinition Height="82" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="94" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="20,12"
            Background="#17212B"
            BorderBrush="#2D4050"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="118" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="27"
                        FontWeight="SemiBold"
                        Foreground="#F8FAFC"
                        Text="Administrator Review Workflow" />
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="#9FB2C3"
                        Text="{Binding FilterSummary}" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding OpenDashboardCommand}"
                    Content="Dashboard" />
                <Button
                    Grid.Column="3"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding OpenReportsCommand}"
                    Content="Reports" />
                <Button
                    Grid.Column="5"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding OpenUserManagementCommand}"
                    Content="User Management" />
                <Button
                    Grid.Column="7"
                    Style="{StaticResource ActionButton}"
                    Background="#1D4ED8"
                    BorderBrush="#60A5FA"
                    Command="{Binding RefreshCommand}"
                    Content="Refresh" />
                <Button
                    Grid.Column="9"
                    Style="{StaticResource ActionButton}"
                    Background="#7F1D1D"
                    BorderBrush="#EF4444"
                    Command="{Binding LogoutCommand}"
                    Content="Logout" />
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Padding="16"
            Background="#17212B"
            BorderBrush="#2D4050"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.ColumnSpan="5"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#9FB2C3"
                    Text="SEARCH EMPLOYEE, ANSWER, SESSION, FILE, HASH, USER ANSWER, OR TRUTH" />
                <TextBlock
                    Grid.Column="6"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#9FB2C3"
                    Text="FILTER" />

                <TextBox
                    Grid.Row="2"
                    Grid.Column="0"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    Grid.Row="2"
                    Grid.Column="2"
                    Style="{StaticResource ActionButton}"
                    Background="#1D4ED8"
                    BorderBrush="#60A5FA"
                    Command="{Binding SearchCommand}"
                    Content="Search" />
                <Button
                    Grid.Row="2"
                    Grid.Column="4"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding ClearSearchCommand}"
                    Content="Clear" />
                <ComboBox
                    Grid.Row="2"
                    Grid.Column="6"
                    ItemsSource="{Binding FilterOptions}"
                    SelectedItem="{Binding SelectedFilter, Mode=TwoWay}" />
                <Button
                    Grid.Row="2"
                    Grid.Column="8"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding SelectVisibleCommand}"
                    Content="Select Visible" />
                <Button
                    Grid.Row="2"
                    Grid.Column="10"
                    Style="{StaticResource ActionButton}"
                    Command="{Binding ClearSelectionCommand}"
                    Content="Clear Selection" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="12"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="#F8FAFC"
                    Text="{Binding SelectionSummary}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SummaryBorder}">
                <StackPanel>
                    <TextBlock Foreground="#9FB2C3" Text="TOTAL ANSWERS" />
                    <TextBlock FontSize="27" FontWeight="Bold" Foreground="#F8FAFC" Text="{Binding TotalAnswers}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource SummaryBorder}">
                <StackPanel>
                    <TextBlock Foreground="#9FB2C3" Text="PENDING" />
                    <TextBlock FontSize="27" FontWeight="Bold" Foreground="#F59E0B" Text="{Binding PendingAnswers}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource SummaryBorder}">
                <StackPanel>
                    <TextBlock Foreground="#9FB2C3" Text="REVIEWED" />
                    <TextBlock FontSize="27" FontWeight="Bold" Foreground="#22C55E" Text="{Binding ReviewedAnswers}" />
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource SummaryBorder}">
                <StackPanel>
                    <TextBlock Foreground="#9FB2C3" Text="VISIBLE / SELECTED" />
                    <TextBlock FontSize="27" FontWeight="Bold" Foreground="#60A5FA">
                        <Run Text="{Binding VisibleAnswers, Mode=OneWay}" />
                        <Run Text=" / " />
                        <Run Text="{Binding SelectedCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="12"
                Background="#17212B"
                BorderBrush="#2D4050"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Foreground="#F8FAFC"
                        Text="Answer Review Queue" />
                    <DataGrid
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        Background="#0F1720"
                        BorderBrush="#2D4050"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserReorderColumns="True"
                        CanUserResizeColumns="True"
                        CanUserSortColumns="True"
                        ColumnHeaderHeight="36"
                        Foreground="#E5E7EB"
                        GridLinesVisibility="Horizontal"
                        HeadersVisibility="Column"
                        HorizontalGridLinesBrush="#263746"
                        ItemsSource="{Binding Answers}"
                        RowBackground="#0F1720"
                        AlternatingRowBackground="#17212B"
                        RowHeight="34"
                        SelectedItem="{Binding SelectedAnswer, Mode=TwoWay}"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="46" Header="Pick">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="68" IsReadOnly="True" Binding="{Binding AnswerID}" Header="Answer" />
                            <DataGridTextColumn Width="68" IsReadOnly="True" Binding="{Binding SessionID}" Header="Session" />
                            <DataGridTextColumn Width="90" IsReadOnly="True" Binding="{Binding EmployeeNo}" Header="Employee" />
                            <DataGridTextColumn Width="130" IsReadOnly="True" Binding="{Binding FileName}" Header="File" />
                            <DataGridTextColumn Width="105" IsReadOnly="True" Binding="{Binding ShortImageHash}" Header="Image Hash" />
                            <DataGridTextColumn Width="72" IsReadOnly="True" Binding="{Binding UserAnswerText}" Header="User" />
                            <DataGridTextColumn Width="76" IsReadOnly="True" Binding="{Binding CorrectAnswerText}" Header="Truth" />
                            <DataGridTextColumn Width="80" IsReadOnly="True" Binding="{Binding ResultText}" Header="Result" />
                            <DataGridTextColumn Width="*" IsReadOnly="True" Binding="{Binding ReviewStatusText}" Header="Review Source" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="16"
                Background="#17212B"
                BorderBrush="#2D4050"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="220" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="#F8FAFC"
                        Text="{Binding SelectedImageCaption}" />
                    <Border
                        Grid.Row="1"
                        Margin="0,12,0,10"
                        Background="#050A0E"
                        BorderBrush="#334155"
                        BorderThickness="1">
                        <Image Source="{Binding SelectedImage}" Stretch="Uniform" />
                    </Border>
                    <TextBlock
                        Grid.Row="2"
                        Foreground="#9FB2C3"
                        Text="{Binding SelectedImageStatus}"
                        TextWrapping="Wrap" />
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Foreground="#9FB2C3" Text="User answer" />
                        <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="#F8FAFC" Text="{Binding SelectedUserAnswerText}" />
                        <TextBlock Grid.Row="1" Foreground="#9FB2C3" Text="Admin truth" />
                        <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="Bold" Foreground="#FCD34D" Text="{Binding SelectedCorrectAnswerText}" />
                        <TextBlock Grid.Row="2" Foreground="#9FB2C3" Text="Result" />
                        <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="Bold" Foreground="#F8FAFC" Text="{Binding SelectedIsCorrectText}" />
                        <TextBlock Grid.Row="3" Foreground="#9FB2C3" Text="Answered" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Foreground="#F8FAFC" Text="{Binding SelectedAnswerTimeText}" />
                        <TextBlock Grid.Row="4" Foreground="#9FB2C3" Text="Review state" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Foreground="#60A5FA" Text="{Binding SelectedReviewStatusText}" TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="8"
            Padding="14"
            Background="#17212B"
            BorderBrush="#2D4050"
            BorderThickness="1"
            CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="14"
                        Foreground="#F8FAFC"
                        Text="{Binding StatusMessage}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Foreground="#9FB2C3"
                        Text="Stable SHA-256 identity controls reuse; ImageID remains display-only." />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Style="{StaticResource ActionButton}"
                    Background="#166534"
                    BorderBrush="#22C55E"
                    Command="{Binding MarkGoodCommand}"
                    Content="Selected = GOOD" />
                <Button
                    Grid.Column="3"
                    Style="{StaticResource ActionButton}"
                    Background="#991B1B"
                    BorderBrush="#EF4444"
                    Command="{Binding MarkNgCommand}"
                    Content="Selected = NG" />
                <Button
                    Grid.Column="5"
                    Style="{StaticResource ActionButton}"
                    Background="#15803D"
                    BorderBrush="#4ADE80"
                    Command="{Binding BulkGoodCommand}"
                    Content="Bulk GOOD" />
                <Button
                    Grid.Column="7"
                    Style="{StaticResource ActionButton}"
                    Background="#B91C1C"
                    BorderBrush="#F87171"
                    Command="{Binding BulkNgCommand}"
                    Content="Bulk NG" />
            </Grid>
        </Border>
    </Grid>
</Window>
