<ui:FluentWindow
    x:Class="VisualInspectionTrainingSystem.Views.Dashboard.DashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="clr-namespace:VisualInspectionTrainingSystem.Controls.Charts"
    xmlns:progress="clr-namespace:VisualInspectionTrainingSystem.Controls.Progress"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Dashboard"
    Width="1280"
    Height="780"
    MinWidth="960"
    MinHeight="620"
    AutomationProperties.Name="Training dashboard"
    Background="{DynamicResource App.BackgroundBrush}"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    Style="{StaticResource FluentAppWindowStyle}"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="28,0"
            Background="{DynamicResource App.NavigationBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="44"
                    Height="44"
                    VerticalAlignment="Center"
                    Background="#24FFFFFF"
                    CornerRadius="12">
                    <ui:SymbolIcon
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Symbol="DataTrending24" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock
                        AutomationProperties.ItemType="Heading"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Training Dashboard" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="#C7D2FE"
                        Text="Today's completed training and trainee answer analytics" />
                </StackPanel>

                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="Refresh dashboard"
                    MinWidth="124"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource DarkActionButtonStyle}"
                    ToolTip="Reload today's metrics and recent sessions">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowSync24" Style="{StaticResource AppIconStyle}" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,24,28,28" Style="{StaticResource ContentEntranceGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="24" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" AutomationProperties.Name="Today's completed training metric" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <ui:SymbolIcon Width="22" Height="22" Foreground="{DynamicResource App.PrimaryBrush}" Symbol="PeopleTeam24" />
                            <TextBlock Margin="0,12,0,0" Style="{StaticResource MetricValueTextStyle}" Text="{Binding TodaysTrainingText}" />
                            <TextBlock Margin="0,7,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="TODAY'S TRAINING" />
                            <TextBlock Margin="0,5,0,0" Style="{StaticResource SupportingTextStyle}" Text="Completed sessions" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" AutomationProperties.Name="Today's reviewed-only average accuracy metric" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <ui:SymbolIcon Width="22" Height="22" Foreground="{DynamicResource App.InfoBrush}" Symbol="Target24" />
                            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource App.InfoBrush}" Style="{StaticResource MetricValueTextStyle}" Text="{Binding AverageReviewedAccuracyText}" />
                            <TextBlock Margin="0,7,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="REVIEWED ACCURACY" />
                            <TextBlock Margin="0,5,0,0" Style="{StaticResource SupportingTextStyle}" Text="{Binding ReviewedAccuracyDetailText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" AutomationProperties.Name="Today's time spent metric" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <ui:SymbolIcon Width="22" Height="22" Foreground="{DynamicResource App.SecondaryBrush}" Symbol="Clock24" />
                            <TextBlock Margin="0,12,0,0" FontSize="26" Foreground="{DynamicResource App.SecondaryBrush}" Style="{StaticResource MetricValueTextStyle}" Text="{Binding TimeSpentText}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,7,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="TIME SPENT" />
                            <TextBlock Margin="0,5,0,0" Style="{StaticResource SupportingTextStyle}" Text="Valid completed durations" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" AutomationProperties.Name="Today's trainee GOOD count metric" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <ui:SymbolIcon Width="22" Height="22" Foreground="{DynamicResource App.SuccessBrush}" Symbol="CheckmarkCircle24" />
                            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource App.SuccessBrush}" Style="{StaticResource MetricValueTextStyle}" Text="{Binding GoodCountText}" />
                            <TextBlock Margin="0,7,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="GOOD COUNT" />
                            <TextBlock Margin="0,5,0,0" Style="{StaticResource SupportingTextStyle}" Text="Includes pending review" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="8" AutomationProperties.Name="Today's trainee NG count metric" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <ui:SymbolIcon Width="22" Height="22" Foreground="{DynamicResource App.DangerBrush}" Symbol="Warning24" />
                            <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource App.DangerBrush}" Style="{StaticResource MetricValueTextStyle}" Text="{Binding NgCountText}" />
                            <TextBlock Margin="0,7,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="NG COUNT" />
                            <TextBlock Margin="0,5,0,0" Style="{StaticResource SupportingTextStyle}" Text="Includes pending review" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Analytics trends" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource SupportingTextStyle}" Text="Completed activity and reviewed-quality trends from one consistent database snapshot" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="1"
                        Width="150"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Dashboard trend range"
                        IsEnabled="{Binding CanSelectTrendRange}"
                        ItemsSource="{Binding TrendDayOptions}"
                        SelectedItem="{Binding SelectedTrendDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Trend range in days" />
                </Grid>

                <ui:Card Grid.Row="4" Style="{StaticResource FluentSurfaceCardStyle}">
                    <charts:AnalyticsChartsPanel DataContext="{Binding Charts}" />
                </ui:Card>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Recent sessions" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource SupportingTextStyle}" Text="Latest training activity across all dates" />
                    </StackPanel>
                    <Border Grid.Column="1" Padding="12,6" VerticalAlignment="Center" Background="{DynamicResource App.InfoSurfaceBrush}" CornerRadius="12">
                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource App.InfoBrush}" Text="TODAY · LOCAL TIME" />
                    </Border>
                </Grid>

                <Border Grid.Row="8" MinHeight="280" Padding="1" Style="{StaticResource SurfaceCardStyle}">
                    <DataGrid
                        AutomationProperties.Name="Recent training sessions"
                        AutoGenerateColumns="False"
                        BorderThickness="0"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        CanUserResizeRows="False"
                        EnableColumnVirtualization="True"
                        EnableRowVirtualization="True"
                        IsReadOnly="True"
                        ItemsSource="{Binding RecentSessions}"
                        MinRowHeight="40"
                        SelectionMode="Single"
                        SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="90" Binding="{Binding SessionID}" Header="Session" />
                            <DataGridTextColumn Width="140" Binding="{Binding EmployeeNo}" Header="Employee" />
                            <DataGridTextColumn Width="170" Binding="{Binding StartTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Header="Start Time" />
                            <DataGridTextColumn Width="170" Binding="{Binding EndTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Header="End Time" />
                            <DataGridTextColumn Width="120" Binding="{Binding TotalQuestions}" Header="Questions" />
                            <DataGridTextColumn Width="110" Binding="{Binding CorrectAnswers}" Header="Correct" />
                            <DataGridTextColumn Width="110" Binding="{Binding WrongAnswers}" Header="Wrong" />
                            <DataGridTextColumn Width="120" Binding="{Binding Accuracy, StringFormat={}{0:0.00}%}" Header="Accuracy" />
                            <DataGridTextColumn Width="*" Binding="{Binding Status}" Header="Status" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="10" Padding="16,12" Background="{DynamicResource App.SurfaceVariantBrush}" CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource App.PrimaryBrush}" Symbol="Info24" />
                        <TextBlock
                            VerticalAlignment="Center"
                            AutomationProperties.ItemType="Status"
                            Foreground="{DynamicResource App.TextSecondaryBrush}"
                            Style="{StaticResource TrimmedTextWithToolTipStyle}"
                            Text="{Binding StatusMessage}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <progress:ModernProgressBar
            Grid.RowSpan="2"
            Panel.ZIndex="100"
            IsActive="{Binding IsBusy}"
            Message="{Binding StatusMessage}" />
    </Grid>
</ui:FluentWindow>
