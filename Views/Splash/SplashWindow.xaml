<Window
    x:Class="VisualInspectionTrainingSystem.Views.Splash.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Visual Inspection Training System"
    Width="1000"
    Height="600"
    AllowsTransparency="True"
    AutomationProperties.Name="Visual Inspection Training System startup"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None">

    <Border
        Background="{StaticResource App.LightSurfaceBrush}"
        CornerRadius="15">
        <Grid>
            <Image
                AutomationProperties.Name="Visual Inspection Training System"
                Source="/Assets/Backgrounds/splash.png"
                Stretch="UniformToFill" />

            <Border Background="#52000000" />

            <Border
                MinHeight="188"
                Padding="32,24,32,22"
                VerticalAlignment="Bottom"
                Background="#F7FFFFFF">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        AutomationProperties.LiveSetting="Polite"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource App.AccentBrush}"
                        Style="{StaticResource TrimmedTextWithToolTipStyle}"
                        Text="{Binding StatusMessage}" />

                    <TextBlock
                        Grid.Row="1"
                        MaxHeight="48"
                        Margin="0,8,0,0"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{StaticResource App.LightSecondaryTextBrush}"
                        Text="{Binding DiagnosticMessage}"
                        TextWrapping="Wrap"
                        ToolTip="{Binding DiagnosticMessage}" />

                    <ProgressBar
                        Grid.Row="2"
                        Height="18"
                        Margin="0,16,0,0"
                        AutomationProperties.Name="Startup progress"
                        Background="#E6EDF3"
                        BorderBrush="#9BA9B5"
                        Foreground="{StaticResource App.SuccessBrush}"
                        Maximum="100"
                        Minimum="0"
                        Value="{Binding Progress}" />

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource App.LightSecondaryTextBrush}"
                            Text="Visual Inspection Training System" />

                        <StackPanel
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource App.LightSecondaryTextBrush}"
                                Text="{Binding Version}" />
                            <Button
                                MinWidth="88"
                                Margin="22,0,0,0"
                                AutomationProperties.Name="Exit application startup"
                                Command="{Binding ExitCommand}"
                                Content="Exit"
                                IsCancel="True"
                                Style="{StaticResource DangerActionButtonStyle}"
                                ToolTip="Cancel startup and close the application" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
