<ui:FluentWindow
    x:Class="VisualInspectionTrainingSystem.Views.Login.RegistrationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vio="http://schemas.lepo.co/wpfui/2022/xaml/violeta"
    Title="Create Account - Visual Inspection Training System"
    Width="980"
    Height="740"
    MinWidth="760"
    MinHeight="620"
    AutomationProperties.Name="Create trainee account"
    Background="{DynamicResource App.BackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    Style="{StaticResource FluentAppWindowStyle}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Panel.ZIndex="20"
            Icon="{ui:SymbolIcon PersonAdd24}"
            Style="{StaticResource FluentAppTitleBarStyle}"
            Title="Create trainee account" />

        <vio:BusyMask
            Grid.Row="1"
            BusyContent="Submitting registration..."
            BusyContentMargin="0,16,0,0"
            FocusAfterBusy="{Binding ElementName=EmployeeInput}"
            IsBusy="{Binding IsBusy}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.82*" MinWidth="280" />
                    <ColumnDefinition Width="1.18*" MinWidth="460" />
                </Grid.ColumnDefinitions>

                <Grid Background="{DynamicResource App.NavigationBrush}" ClipToBounds="True">
                    <Ellipse Width="330" Height="330" Margin="-160,-170,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="{DynamicResource App.SecondaryBrush}" Opacity="0.16" />
                    <Ellipse Width="260" Height="260" Margin="0,0,-120,-130" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{DynamicResource App.NavigationRaisedBrush}" />

                    <StackPanel Margin="42" VerticalAlignment="Center">
                        <Border Width="70" Height="70" HorizontalAlignment="Left" Background="{DynamicResource App.NavigationRaisedBrush}" CornerRadius="22">
                            <ui:SymbolIcon Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource App.SecondaryBrush}" Symbol="PersonAdd24" />
                        </Border>
                        <TextBlock Margin="0,24,0,0" AutomationProperties.HeadingLevel="Level1" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="31" FontWeight="Bold" Foreground="{DynamicResource App.DarkTextBrush}" Text="Create your trainee account" TextWrapping="Wrap" />
                        <TextBlock Margin="0,15,0,0" FontSize="15" Foreground="{DynamicResource App.DarkSecondaryTextBrush}" LineHeight="23" Text="Registration creates a secure inactive trainee profile. An administrator must verify and activate the account before the first sign-in." TextWrapping="Wrap" />

                        <StackPanel Margin="0,30,0,0">
                            <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                <ui:SymbolIcon Width="21" Height="21" Margin="0,0,10,0" Foreground="{DynamicResource App.SuccessBrush}" Symbol="ShieldCheckmark24" />
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource App.DarkTextBrush}" Text="Password stored securely" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                                <ui:SymbolIcon Width="21" Height="21" Margin="0,0,10,0" Foreground="{DynamicResource App.WarningBrush}" Symbol="Clock24" />
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource App.DarkTextBrush}" Text="Activation required" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Width="21" Height="21" Margin="0,0,10,0" Foreground="{DynamicResource App.SecondaryBrush}" Symbol="PersonAvailable24" />
                                <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource App.DarkTextBrush}" Text="Trainee access only" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Grid Grid.Column="1" Margin="32,26">
                    <ui:Card MaxWidth="570" Padding="34,28" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource FluentElevatedCardStyle}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock AutomationProperties.HeadingLevel="Level1" Style="{StaticResource PageTitleTextStyle}" Text="Trainee registration" />
                                <TextBlock Margin="0,6,0,20" Style="{StaticResource SupportingTextStyle}" Text="Enter your work profile and choose a strong password." TextWrapping="Wrap" />

                                <ui:TextBox x:Name="EmployeeInput" TabIndex="0" Margin="0,0,0,14" AutomationProperties.Name="Employee Number" ClearButtonEnabled="True" Icon="{ui:SymbolIcon Person24}" MaxLength="20" PlaceholderText="Employee number" Style="{StaticResource FluentTextBoxStyle}" Text="{Binding EmployeeNo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter a unique employee number" />
                                <ui:TextBox x:Name="FullNameInput" TabIndex="1" Margin="0,0,0,14" AutomationProperties.Name="Full Name" ClearButtonEnabled="True" Icon="{ui:SymbolIcon Person24}" MaxLength="100" PlaceholderText="Full name" Style="{StaticResource FluentTextBoxStyle}" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the trainee's full name" />
                                <ui:TextBox x:Name="DepartmentInput" TabIndex="2" Margin="0,0,0,14" AutomationProperties.Name="Department" ClearButtonEnabled="True" Icon="{ui:SymbolIcon Building24}" MaxLength="50" PlaceholderText="Department" Style="{StaticResource FluentTextBoxStyle}" Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter the trainee's department" />
                                <ui:PasswordBox x:Name="PasswordInput" TabIndex="3" Margin="0,0,0,6" AutomationProperties.Name="Password" MaxLength="72" Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PasswordChar="&#x25CF;" PlaceholderText="Password" Style="{StaticResource FluentPasswordBoxStyle}" ToolTip="Enter a password between 8 and 72 UTF-8 bytes" />
                                <TextBlock Margin="12,0,0,12" FontSize="11" Foreground="{DynamicResource App.TextMutedBrush}" Text="Use 8–72 UTF-8 bytes" />
                                <ui:PasswordBox x:Name="ConfirmPasswordInput" TabIndex="4" AutomationProperties.Name="Confirm Password" MaxLength="72" Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PasswordChar="&#x25CF;" PlaceholderText="Confirm password" Style="{StaticResource FluentPasswordBoxStyle}" ToolTip="Enter the same password again" />

                                <Border Margin="0,18,0,0" Padding="12,9" Style="{StaticResource PendingChipStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Width="19" Height="19" Margin="0,0,9,0" Foreground="{DynamicResource App.WarningBrush}" Symbol="Info24" />
                                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="Administrator activation is required before login." TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Margin="0,13,0,0" MinHeight="36" AutomationProperties.LiveSetting="Assertive" Style="{StaticResource StatusMessageTextStyle}" Text="{Binding StatusMessage}" ToolTip="{Binding StatusMessage}" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.35*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0" TabIndex="5" Appearance="Primary" AutomationProperties.Name="Submit trainee registration" Command="{Binding SubmitCommand}" Icon="{ui:SymbolIcon PersonAvailable24}" IsDefault="True" ToolTip="Submit an inactive trainee account for administrator activation">Submit Registration</ui:Button>
                                    <ui:Button Grid.Column="2" TabIndex="6" Appearance="Secondary" AutomationProperties.Name="Cancel registration" Command="{Binding CancelCommand}" Icon="{ui:SymbolIcon ArrowLeft24}" IsCancel="True" ToolTip="Close registration and return to Login">Back to Login</ui:Button>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </ui:Card>
                </Grid>
            </Grid>
        </vio:BusyMask>
    </Grid>
</ui:FluentWindow>
