<Window
    x:Class="VisualInspectionTrainingSystem.Views.Login.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:VisualInspectionTrainingSystem.Helpers"
    Title="Visual Inspection Training System"
    Width="1000"
    Height="650"
    Background="#F5F7FA"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#0F4C81">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image
                    Width="220"
                    Height="220"
                    Source="/Assets/Logos/logo.png"
                    Stretch="Uniform" />
                <TextBlock
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="VISUAL INSPECTION" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="22"
                    Foreground="White"
                    Text="TRAINING SYSTEM" />
                <TextBlock
                    Margin="0,30,0,0"
                    HorizontalAlignment="Center"
                    FontSize="15"
                    Foreground="White"
                    Text="Product Appearance Training" />
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" Padding="40" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="35" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#263238"
                    Text="LOGIN" />

                <StackPanel Grid.Row="2">
                    <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Employee Number" />
                    <TextBox
                        Height="40"
                        Padding="10,5"
                        FontSize="15"
                        Text="{Binding EmployeeNo, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Password" />
                    <PasswordBox
                        Height="40"
                        Padding="10,5"
                        FontSize="15"
                        helpers:PasswordBoxHelper.BindPassword="True"
                        helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}" />
                </StackPanel>

                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Height="42"
                        Background="#0F4C81"
                        BorderThickness="0"
                        Command="{Binding LoginCommand}"
                        Content="LOGIN"
                        Cursor="Hand"
                        FontWeight="Bold"
                        Foreground="White" />
                    <Button
                        Grid.Column="2"
                        Height="42"
                        Command="{Binding ExitCommand}"
                        Content="EXIT"
                        Cursor="Hand" />
                </Grid>

                <Button
                    Grid.Row="8"
                    Height="42"
                    Background="White"
                    BorderBrush="#0F4C81"
                    BorderThickness="1"
                    Command="{Binding RegisterCommand}"
                    Content="CREATE ACCOUNT"
                    Cursor="Hand"
                    FontWeight="Bold"
                    Foreground="#0F4C81" />

                <TextBlock
                    Grid.Row="10"
                    MinHeight="38"
                    FontWeight="SemiBold"
                    Foreground="Red"
                    Text="{Binding StatusMessage}"
                    TextWrapping="Wrap" />

                <DockPanel Grid.Row="12">
                    <TextBlock Text="Samsung Electro-Mechanics Philippines" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Version}" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
