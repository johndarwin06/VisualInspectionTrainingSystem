<Window
    x:Class="VisualInspectionTrainingSystem.Views.Login.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:VisualInspectionTrainingSystem.Helpers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:progress="clr-namespace:VisualInspectionTrainingSystem.Controls.Progress"
    Title="Visual Inspection Training System"
    Width="1080"
    Height="680"
    MinWidth="780"
    MinHeight="580"
    AutomationProperties.Name="Visual Inspection Training System login"
    Background="{DynamicResource App.BackgroundBrush}"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" MinWidth="350" />
            <ColumnDefinition Width="*" MinWidth="410" />
        </Grid.ColumnDefinitions>

        <!-- Branded vector panel -->
        <Grid Grid.Column="0" Background="{DynamicResource App.NavigationBrush}" ClipToBounds="True">
            <Ellipse
                Width="420"
                Height="420"
                Margin="-180,-210,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="{DynamicResource App.NavigationRaisedBrush}"
                Opacity="0.72" />
            <Ellipse
                Width="360"
                Height="360"
                Margin="0,0,-170,-180"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Fill="{DynamicResource App.SecondaryBrush}"
                Opacity="0.2" />
            <Path
                Width="260"
                Height="260"
                Margin="0,80,-250,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Data="M 0,130 L 130,0 260,130 130,260 Z"
                Fill="{DynamicResource App.SecondaryBrush}"
                Opacity="0.1"
                Stretch="Uniform" />

            <StackPanel
                MaxWidth="470"
                Margin="48"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Border
                    Width="92"
                    Height="92"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource App.NavigationRaisedBrush}"
                    CornerRadius="28"
                    materialDesign:ElevationAssist.Elevation="Dp6">
                    <materialDesign:PackIcon
                        Width="52"
                        Height="52"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Visual inspection training"
                        Foreground="{DynamicResource App.SecondaryBrush}"
                        Kind="ImageSearchOutline" />
                </Border>
                <TextBlock
                    Margin="0,28,0,0"
                    AutomationProperties.HeadingLevel="Level1"
                    FontFamily="Segoe UI Variable Display, Segoe UI"
                    FontSize="38"
                    FontWeight="Bold"
                    Foreground="{DynamicResource App.DarkTextBrush}"
                    Text="Train the eye.&#x0a;Improve the decision."
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,18,0,0"
                    MaxWidth="430"
                    FontSize="16"
                    Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                    LineHeight="25"
                    Text="A focused visual-inspection workspace for consistent GOOD and NG classification, administrator review, and measurable training progress."
                    TextWrapping="Wrap" />

                <StackPanel Margin="0,34,0,0" Orientation="Horizontal">
                    <Border Margin="0,0,10,0" Padding="12,7" Background="{DynamicResource App.NavigationRaisedBrush}" CornerRadius="100">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="17" Height="17" Margin="0,0,7,0" Foreground="{DynamicResource App.SuccessBrush}" Kind="ShieldCheckOutline" />
                            <TextBlock Foreground="{DynamicResource App.DarkTextBrush}" Text="Secure access" />
                        </StackPanel>
                    </Border>
                    <Border Padding="12,7" Background="{DynamicResource App.NavigationRaisedBrush}" CornerRadius="100">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="17" Height="17" Margin="0,0,7,0" Foreground="{DynamicResource App.SecondaryBrush}" Kind="ChartTimelineVariant" />
                            <TextBlock Foreground="{DynamicResource App.DarkTextBrush}" Text="Reviewed progress" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Authentication card -->
        <Grid Grid.Column="1" Margin="42,32">
            <Border
                MaxWidth="440"
                Padding="38,34"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource SurfaceCardStyle}"
                materialDesign:ElevationAssist.Elevation="Dp4">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <Grid Style="{StaticResource ContentEntranceGridStyle}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="26" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <Border
                                Width="46"
                                Height="46"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource App.SecondarySurfaceBrush}"
                                CornerRadius="14">
                                <materialDesign:PackIcon
                                    Width="25"
                                    Height="25"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource App.PrimaryBrush}"
                                    Kind="AccountLockOutline" />
                            </Border>
                            <TextBlock
                                Margin="0,18,0,0"
                                AutomationProperties.HeadingLevel="Level1"
                                Style="{StaticResource PageTitleTextStyle}"
                                Text="Welcome back" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource SupportingTextStyle}"
                                Text="Sign in with your employee account to continue." />
                        </StackPanel>

                        <TextBox
                            x:Name="EmployeeInput"
                            Grid.Row="2"
                            TabIndex="0"
                            AutomationProperties.Name="Employee Number"
                            MaxLength="20"
                            materialDesign:HintAssist.Hint="Employee Number"
                            Text="{Binding EmployeeNo, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Enter your employee number" />

                        <PasswordBox
                            x:Name="PasswordInput"
                            Grid.Row="4"
                            TabIndex="1"
                            AutomationProperties.Name="Password"
                            MaxLength="72"
                            helpers:PasswordBoxHelper.BindPassword="True"
                            helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}"
                            materialDesign:HintAssist.Hint="Password"
                            ToolTip="Enter your password" />

                        <Grid Grid.Row="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button
                                Grid.Column="0"
                                TabIndex="2"
                                AutomationProperties.Name="Log in"
                                Command="{Binding LoginCommand}"
                                IsDefault="True"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                ToolTip="Sign in to the application">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Login" Style="{StaticResource AppIconStyle}" />
                                    <TextBlock VerticalAlignment="Center" Text="Sign In" />
                                </StackPanel>
                            </Button>
                            <Button
                                Grid.Column="2"
                                TabIndex="3"
                                AutomationProperties.Name="Exit application"
                                Command="{Binding ExitCommand}"
                                IsCancel="True"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                ToolTip="Close the application">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Close" Style="{StaticResource AppIconStyle}" />
                                    <TextBlock VerticalAlignment="Center" Text="Exit" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Button
                            Grid.Row="8"
                            TabIndex="4"
                            AutomationProperties.Name="Create a trainee account"
                            Command="{Binding RegisterCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            ToolTip="Open trainee registration">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountPlusOutline" Style="{StaticResource AppIconStyle}" />
                                <TextBlock VerticalAlignment="Center" Text="Create Trainee Account" />
                            </StackPanel>
                        </Button>

                        <TextBlock
                            Grid.Row="10"
                            MinHeight="38"
                            AutomationProperties.LiveSetting="Assertive"
                            Style="{StaticResource StatusMessageTextStyle}"
                            Text="{Binding StatusMessage}"
                            ToolTip="{Binding StatusMessage}" />

                        <Grid Grid.Row="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Foreground="{DynamicResource App.TextMutedBrush}"
                                Text="Samsung Electro-Mechanics Philippines"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="Samsung Electro-Mechanics Philippines" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="14,0,0,0"
                                Foreground="{DynamicResource App.TextMutedBrush}"
                                Text="{Binding Version}" />
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <progress:ModernProgressBar
            Grid.ColumnSpan="2"
            Panel.ZIndex="100"
            IsActive="{Binding IsBusy}"
            Message="Signing in securely..." />
    </Grid>
</Window>
