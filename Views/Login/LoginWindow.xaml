<Window
    x:Class="VisualInspectionTrainingSystem.Views.Login.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:VisualInspectionTrainingSystem.Helpers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:progress="clr-namespace:VisualInspectionTrainingSystem.Controls.Progress"
    Title="Visual Inspection Training System"
    Width="1000"
    Height="650"
    MinWidth="760"
    MinHeight="560"
    AutomationProperties.Name="Visual Inspection Training System login"
    Background="{StaticResource App.LightMutedSurfaceBrush}"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="SingleBorderWindow">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="320" />
            <ColumnDefinition Width="2*" MinWidth="340" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource App.AccentBrush}">
            <StackPanel
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Image
                    Width="220"
                    Height="220"
                    MaxWidth="220"
                    MaxHeight="220"
                    AutomationProperties.Name="Visual Inspection Training System logo"
                    Source="/Assets/Logos/logo.png"
                    Stretch="Uniform" />
                <TextBlock
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.HeadingLevel="Level1"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="VISUAL INSPECTION"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="22"
                    Foreground="White"
                    Text="TRAINING SYSTEM"
                    TextAlignment="Center" />
                <TextBlock
                    Margin="0,30,0,0"
                    HorizontalAlignment="Center"
                    FontSize="15"
                    Foreground="White"
                    Text="Product Appearance Training" />
            </StackPanel>
        </Grid>

        <Border
            Grid.Column="1"
            Padding="40,32"
            Background="{StaticResource App.LightSurfaceBrush}">
            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="24" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            FontSize="28"
                            FontWeight="Bold"
                            Foreground="{StaticResource App.LightTextBrush}"
                            Text="LOGIN" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Foreground="{StaticResource App.LightSecondaryTextBrush}"
                            Text="Sign in with your employee account."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Label
                            Padding="0,0,0,5"
                            FontWeight="SemiBold"
                            Target="{Binding ElementName=EmployeeInput}">
                            Employee Number
                        </Label>
                        <TextBox
                            x:Name="EmployeeInput"
                            TabIndex="0"
                            AutomationProperties.Name="Employee Number"
                            MaxLength="20"
                            Text="{Binding EmployeeNo, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="Enter your employee number" />
                    </StackPanel>

                    <StackPanel Grid.Row="4">
                        <Label
                            Padding="0,0,0,5"
                            FontWeight="SemiBold"
                            Target="{Binding ElementName=PasswordInput}">
                            Password
                        </Label>
                        <PasswordBox
                            x:Name="PasswordInput"
                            TabIndex="1"
                            AutomationProperties.Name="Password"
                            MaxLength="72"
                            helpers:PasswordBoxHelper.BindPassword="True"
                            helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay}"
                            ToolTip="Enter your password" />
                    </StackPanel>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="0"
                            TabIndex="2"
                            AutomationProperties.Name="Log in"
                            Command="{Binding LoginCommand}"
                            IsDefault="True"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            ToolTip="Sign in to the application">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Login" Style="{StaticResource AppIconStyle}" />
                                <TextBlock VerticalAlignment="Center" Text="LOGIN" />
                            </StackPanel>
                        </Button>
                        <Button
                            Grid.Column="2"
                            TabIndex="3"
                            AutomationProperties.Name="Exit application"
                            Command="{Binding ExitCommand}"
                            IsCancel="True"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            ToolTip="Close the application">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Style="{StaticResource AppIconStyle}" />
                                <TextBlock VerticalAlignment="Center" Text="EXIT" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Button
                        Grid.Row="8"
                        TabIndex="4"
                        AutomationProperties.Name="Create a trainee account"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        ToolTip="Open trainee registration">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlusOutline" Style="{StaticResource AppIconStyle}" />
                            <TextBlock VerticalAlignment="Center" Text="CREATE ACCOUNT" />
                        </StackPanel>
                    </Button>

                    <TextBlock
                        Grid.Row="10"
                        MinHeight="40"
                        AutomationProperties.LiveSetting="Assertive"
                        Style="{StaticResource StatusMessageTextStyle}"
                        Text="{Binding StatusMessage}"
                        ToolTip="{Binding StatusMessage}" />

                    <DockPanel Grid.Row="12" LastChildFill="False">
                        <TextBlock
                            Margin="0,0,12,0"
                            Foreground="{StaticResource App.LightSecondaryTextBrush}"
                            Text="Samsung Electro-Mechanics Philippines"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="Samsung Electro-Mechanics Philippines" />
                        <TextBlock
                            DockPanel.Dock="Right"
                            Foreground="{StaticResource App.LightSecondaryTextBrush}"
                            Text="{Binding Version}" />
                    </DockPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <progress:ModernProgressBar
            Grid.ColumnSpan="2"
            Panel.ZIndex="100"
            IsActive="{Binding IsBusy}"
            Message="Signing in securely..." />
    </Grid>
</Window>
