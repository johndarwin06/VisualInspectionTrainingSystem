<Window
    x:Class="VisualInspectionTrainingSystem.Views.History.TrainingHistoryDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Training Result"
    Width="1180"
    Height="760"
    MinWidth="820"
    MinHeight="560"
    AutomationProperties.Name="Read-only training result"
    Background="{StaticResource App.LightMutedSurfaceBrush}"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="28" Style="{StaticResource ContentEntranceGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock AutomationProperties.HeadingLevel="Level1" FontSize="28" FontWeight="Bold" Foreground="{StaticResource App.LightTextBrush}" Text="{Binding SessionTitle}" />
                <TextBlock Margin="0,5,0,0" Foreground="{StaticResource App.LightSecondaryTextBrush}" Text="Read-only answer details and reviewed outcomes for your completed session." TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" MinWidth="120" AutomationProperties.Name="Refresh training result" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryActionButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Style="{StaticResource AppIconStyle}" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>
        <UniformGrid Grid.Row="2" Columns="5">
            <Border Margin="0,0,8,0" Padding="14" Background="{StaticResource App.LightSurfaceBrush}" BorderBrush="{StaticResource App.LightBorderBrush}" BorderThickness="1" CornerRadius="9" Style="{StaticResource InteractiveCardStyle}">
                <StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="Completed" /><TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding Summary.CompletionTimeText, TargetNullValue=N/A}" /></StackPanel>
            </Border>
            <Border Margin="2,0,8,0" Padding="14" Background="{StaticResource App.LightSurfaceBrush}" BorderBrush="{StaticResource App.LightBorderBrush}" BorderThickness="1" CornerRadius="9" Style="{StaticResource InteractiveCardStyle}">
                <StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="Duration" /><TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding Summary.DurationText, TargetNullValue=N/A}" /></StackPanel>
            </Border>
            <Border Margin="2,0,8,0" Padding="14" Background="{StaticResource App.LightSurfaceBrush}" BorderBrush="{StaticResource App.LightBorderBrush}" BorderThickness="1" CornerRadius="9" Style="{StaticResource InteractiveCardStyle}">
                <StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="Questions" /><TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding Summary.TotalQuestions, TargetNullValue=0}" /></StackPanel>
            </Border>
            <Border Margin="2,0,8,0" Padding="14" Background="{StaticResource App.LightSurfaceBrush}" BorderBrush="{StaticResource App.LightBorderBrush}" BorderThickness="1" CornerRadius="9" Style="{StaticResource InteractiveCardStyle}">
                <StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="Reviewed Accuracy" /><TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Foreground="{StaticResource App.AccentBrush}" Text="{Binding Summary.ReviewedAccuracyText, TargetNullValue=N/A}" /></StackPanel>
            </Border>
            <Border Margin="2,0,0,0" Padding="14" Background="{StaticResource App.LightSurfaceBrush}" BorderBrush="{StaticResource App.LightBorderBrush}" BorderThickness="1" CornerRadius="9" Style="{StaticResource InteractiveCardStyle}">
                <StackPanel><TextBlock Style="{StaticResource FieldLabelStyle}" Text="Review Status" /><TextBlock Margin="0,5,0,0" FontWeight="SemiBold" Text="{Binding Summary.ReviewStatusText, TargetNullValue=Unavailable}" /></StackPanel>
            </Border>
        </UniformGrid>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="480" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="260" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource App.LightSurfaceBrush}" BorderBrush="{StaticResource App.LightBorderBrush}" BorderThickness="1" CornerRadius="10">
                <DataGrid Margin="1" AutomationProperties.Name="Training answer details" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" EnableRowVirtualization="True" IsReadOnly="True" ItemsSource="{Binding Answers}" SelectedItem="{Binding SelectedAnswer}" SelectionMode="Single" RowHeaderWidth="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="50" Binding="{Binding QuestionNumber}" Header="#" />
                        <DataGridTextColumn Width="*" Binding="{Binding ImageDisplayText}" Header="Image" />
                        <DataGridTextColumn Width="78" Binding="{Binding UserAnswerText}" Header="Your Answer" />
                        <DataGridTextColumn Width="82" Binding="{Binding CorrectAnswerText}" Header="Truth" />
                        <DataGridTextColumn Width="88" Binding="{Binding OutcomeText}" Header="Outcome" />
                        <DataGridTextColumn Width="125" Binding="{Binding ReviewSourceText}" Header="Review Source" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border Grid.Column="2" Padding="16" Background="{StaticResource App.LightSurfaceBrush}" BorderBrush="{StaticResource App.LightBorderBrush}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="10" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock AutomationProperties.HeadingLevel="Level2" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource App.LightTextBrush}" Text="Selected Image" />
                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource App.LightSecondaryTextBrush}" Style="{StaticResource TrimmedTextWithToolTipStyle}" Text="{Binding SelectedAnswer.ImageDisplayText, TargetNullValue=Select an answer}" />
                    </StackPanel>
                    <Border Grid.Row="2" Background="{StaticResource App.LightMutedSurfaceBrush}" BorderBrush="{StaticResource App.LightBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Image Margin="8" Source="{Binding SelectedImagePreview}" Stretch="Uniform" />
                            <ProgressBar Width="150" Height="6" IsIndeterminate="True" Visibility="{Binding IsPreviewLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="4" Foreground="{StaticResource App.LightSecondaryTextBrush}" Text="{Binding PreviewStatus}" TextAlignment="Center" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <Border Grid.ColumnSpan="3" Background="{StaticResource App.BusyScrimBrush}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="220" Height="6" IsIndeterminate="True" />
                    <TextBlock Margin="0,14,0,0" FontSize="16" Foreground="White" Text="Loading your training result..." />
                </StackPanel>
            </Border>
        </Grid>
        <StackPanel Grid.Row="6">
            <TextBlock Foreground="{StaticResource App.LightSecondaryTextBrush}" Style="{StaticResource StatusMessageTextStyle}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource App.LightSecondaryTextBrush}" Text="Pending answers have no supported GOOD/NG truth and are excluded from reviewed accuracy." />
        </StackPanel>
    </Grid>
</Window>
