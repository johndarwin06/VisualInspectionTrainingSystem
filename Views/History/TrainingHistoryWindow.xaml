<Window
    x:Class="VisualInspectionTrainingSystem.Views.History.TrainingHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="My Training History"
    Width="1200"
    Height="760"
    MinWidth="780"
    MinHeight="560"
    AutomationProperties.Name="My training history"
    Background="{DynamicResource App.BackgroundBrush}"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="28,0"
            Background="{DynamicResource App.NavigationBrush}"
            materialDesign:ElevationAssist.Elevation="Dp6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border Width="50" Height="50" Margin="0,0,16,0" Background="{DynamicResource App.NavigationRaisedBrush}" CornerRadius="15">
                        <materialDesign:PackIcon Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource App.SecondaryBrush}" Kind="History" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock AutomationProperties.HeadingLevel="Level1" FontSize="25" FontWeight="SemiBold" Foreground="{DynamicResource App.DarkTextBrush}" Text="My Training History" />
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource App.DarkSecondaryTextBrush}" Text="Completed sessions, reviewed outcomes, and pending answers" />
                    </StackPanel>
                </StackPanel>
                <Button
                    Grid.Column="1"
                    MinWidth="126"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Refresh training history"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource DarkActionButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" Style="{StaticResource AppIconStyle}" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,26" Style="{StaticResource ContentEntranceGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource FilterBarStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="190" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="145" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="145" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="175" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        AutomationProperties.Name="Search by session or image filename"
                        materialDesign:HintAssist.Hint="Search session or image"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="Search by exact session number or image filename" />
                    <DatePicker
                        Grid.Column="2"
                        AutomationProperties.Name="Completed from date"
                        materialDesign:HintAssist.Hint="Completed from"
                        SelectedDate="{Binding StartDate}" />
                    <DatePicker
                        Grid.Column="4"
                        AutomationProperties.Name="Completed through date"
                        materialDesign:HintAssist.Hint="Completed through"
                        SelectedDate="{Binding EndDate}" />
                    <ComboBox
                        Grid.Column="6"
                        AutomationProperties.Name="Review status filter"
                        ItemsSource="{Binding ReviewStatusOptions}"
                        materialDesign:HintAssist.Hint="Review status"
                        SelectedItem="{Binding SelectedReviewStatus}" />
                    <Button
                        Grid.Column="8"
                        MinWidth="108"
                        AutomationProperties.Name="Clear history filters"
                        Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource SecondaryActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilterOffOutline" Style="{StaticResource AppIconStyle}" />
                            <TextBlock Text="Clear" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="1" Style="{StaticResource SurfaceCardStyle}">
                <Grid>
                    <DataGrid
                        x:Name="HistoryGrid"
                        AutomationProperties.Name="Completed training sessions"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserDeleteRows="False"
                        EnableColumnVirtualization="True"
                        EnableRowVirtualization="True"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding Sessions}"
                        RowHeaderWidth="0"
                        SelectionMode="Single"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="150" Binding="{Binding CompletionTimeText}" Header="Completed" />
                            <DataGridTextColumn Width="95" Binding="{Binding DurationText}" Header="Duration" />
                            <DataGridTextColumn Width="90" Binding="{Binding TotalQuestions}" Header="Questions" />
                            <DataGridTextColumn Width="70" Binding="{Binding UserGoodAnswers}" Header="GOOD" />
                            <DataGridTextColumn Width="65" Binding="{Binding UserNgAnswers}" Header="NG" />
                            <DataGridTextColumn Width="90" Binding="{Binding ReviewedAnswers}" Header="Reviewed" />
                            <DataGridTextColumn Width="85" Binding="{Binding PendingAnswers}" Header="Pending" />
                            <DataGridTextColumn Width="110" Binding="{Binding ReviewedAccuracyText}" Header="Accuracy*" />
                            <DataGridTemplateColumn Width="155" Header="Review Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Margin="4">
                                            <Border.Style>
                                                <Style BasedOn="{StaticResource PendingChipStyle}" TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ReviewStatusText}" Value="Reviewed"><Setter Property="Background" Value="{DynamicResource App.SuccessSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource App.SuccessBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding ReviewStatusText}" Value="Partially Reviewed"><Setter Property="Background" Value="{DynamicResource App.InfoSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource App.InfoBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="{Binding ReviewStatusText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="125" Header="Result">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            MinWidth="96"
                                            Margin="4"
                                            AutomationProperties.Name="Open training result"
                                            Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Content="View Result"
                                            Style="{StaticResource SecondaryActionButtonStyle}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource EmptyStateEntranceStyle}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Border Width="70" Height="70" HorizontalAlignment="Center" Background="{DynamicResource App.SurfaceVariantBrush}" CornerRadius="22">
                            <materialDesign:PackIcon Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource App.TextMutedBrush}" Kind="History" />
                        </Border>
                        <TextBlock Margin="0,14,0,0" FontSize="16" Foreground="{DynamicResource App.TextSecondaryBrush}" Text="{Binding EmptyStateText}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Background="{DynamicResource App.BusyScrimBrush}" CornerRadius="15" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar Width="220" Height="7" IsIndeterminate="True" />
                            <TextBlock Margin="0,14,0,0" FontSize="16" Foreground="White" Text="Loading your training history..." />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}" Style="{StaticResource StatusMessageTextStyle}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource App.TextMutedBrush}" Text="* Accuracy uses reviewed answers only; pending answers are excluded." />
                </StackPanel>
                <Button Grid.Column="1" MinWidth="138" AutomationProperties.Name="Load more training sessions" Command="{Binding LoadMoreCommand}" Content="Load More" Style="{StaticResource SecondaryActionButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
