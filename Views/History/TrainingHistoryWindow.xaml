<ui:FluentWindow
    x:Class="VisualInspectionTrainingSystem.Views.History.TrainingHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="clr-namespace:VisualInspectionTrainingSystem.Controls.Charts"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="My Training History"
    Width="1200"
    Height="780"
    MinWidth="780"
    MinHeight="560"
    AutomationProperties.Name="My training history"
    Background="{DynamicResource App.BackgroundBrush}"
    KeyboardNavigation.TabNavigation="Cycle"
    PreviewKeyDown="OnPreviewKeyDown"
    ResizeMode="CanResize"
    Style="{StaticResource FluentAppWindowStyle}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.Resources>
        <Style
            x:Key="HistoryTabItemStyle"
            BasedOn="{StaticResource {x:Type TabItem}}"
            TargetType="TabItem">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Padding" Value="20,11" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="28,0"
            Background="{DynamicResource App.NavigationBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Width="50"
                        Height="50"
                        Margin="0,0,16,0"
                        Background="{DynamicResource App.NavigationRaisedBrush}"
                        CornerRadius="15">
                        <ui:SymbolIcon
                            Width="28"
                            Height="28"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource App.SecondaryBrush}"
                            Symbol="History24" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            AutomationProperties.ItemType="Heading"
                            FontSize="25"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.DarkTextBrush}"
                            Text="My Training History" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                            Text="Personal progress, completed sessions, and reviewed outcomes" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button
                        x:Name="BackButton"
                        MinWidth="142"
                        Margin="0,0,10,0"
                        AutomationProperties.HelpText="Close training history and return to the trainee workspace."
                        AutomationProperties.Name="Back to trainee home"
                        Click="OnBackRequested"
                        Style="{StaticResource DarkActionButtonStyle}"
                        TabIndex="0"
                        ToolTip="Back to Home (Esc)">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowLeft24" Style="{StaticResource AppIconStyle}" />
                            <TextBlock Text="Back to Home" />
                        </StackPanel>
                    </Button>
                    <Button
                        MinWidth="126"
                        AutomationProperties.Name="Refresh training history and progress"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource DarkActionButtonStyle}"
                        TabIndex="1">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" Style="{StaticResource AppIconStyle}" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl
            Grid.Row="1"
            Margin="28,22,28,26"
            AutomationProperties.Name="Training history sections"
            Background="{DynamicResource App.SurfaceBrush}"
            BorderBrush="{DynamicResource App.BorderBrush}">

            <TabItem
                AutomationProperties.Name="My Progress"
                Style="{StaticResource HistoryTabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,9,0"
                            VerticalAlignment="Center"
                            Symbol="DataTrending24" />
                        <TextBlock VerticalAlignment="Center" Text="My Progress" />
                    </StackPanel>
                </TabItem.Header>

                <Grid
                    Margin="10"
                    Background="{DynamicResource App.BackgroundBrush}"
                    Style="{StaticResource ContentEntranceGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="18,14" Style="{StaticResource SurfaceCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Personal analytics" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    Style="{StaticResource SupportingTextStyle}"
                                    Text="Completed activity and reviewed-only quality for your account"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock
                                    Margin="0,0,0,5"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                                    Text="PROGRESS RANGE" />
                                <ComboBox
                                    Width="168"
                                    AutomationProperties.Name="Personal progress range in days"
                                    IsEnabled="{Binding CanSelectAnalyticsRange}"
                                    ItemsSource="{Binding AnalyticsDayOptions}"
                                    SelectedItem="{Binding SelectedAnalyticsDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="Progress range in days">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding Mode=OneWay}" />
                                                <Run Text=" days" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            PanningMode="Both"
                            VerticalScrollBarVisibility="Auto">
                            <charts:AnalyticsChartsPanel
                                Margin="0,0,6,6"
                                DataContext="{Binding Charts}" />
                        </ScrollViewer>

                        <Border
                            Background="{DynamicResource App.BusyScrimBrush}"
                            CornerRadius="15"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar Width="220" Height="7" IsIndeterminate="True" />
                                <TextBlock
                                    Margin="0,14,0,0"
                                    FontSize="16"
                                    Foreground="White"
                                    Text="Loading your personal progress..." />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="4"
                        Padding="14,10"
                        Background="{DynamicResource App.SurfaceVariantBrush}"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource App.PrimaryBrush}"
                                Symbol="Info24" />
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.ItemType="Status"
                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                Text="{Binding StatusMessage}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem
                AutomationProperties.Name="Sessions"
                Style="{StaticResource HistoryTabItemStyle}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,9,0"
                            VerticalAlignment="Center"
                            Symbol="History24" />
                        <TextBlock VerticalAlignment="Center" Text="Sessions" />
                    </StackPanel>
                </TabItem.Header>

                <Grid
                    Margin="10"
                    Background="{DynamicResource App.BackgroundBrush}"
                    Style="{StaticResource ContentEntranceGridStyle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource FilterBarStyle}">
                        <WrapPanel VerticalAlignment="Center">
                            <ui:TextBox
                                Width="245"
                                Margin="0,0,12,8"
                                AutomationProperties.Name="Search by session or image filename"
                                PlaceholderText="Search session or image"
                                Style="{StaticResource FluentTextBoxStyle}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                ToolTip="Search by exact session number or image filename" />
                            <DatePicker
                                Width="168"
                                Margin="0,0,12,8"
                                AutomationProperties.Name="Completed from date"
                                ToolTip="Completed from"
                                SelectedDate="{Binding StartDate}" />
                            <DatePicker
                                Width="168"
                                Margin="0,0,12,8"
                                AutomationProperties.Name="Completed through date"
                                ToolTip="Completed through"
                                SelectedDate="{Binding EndDate}" />
                            <ComboBox
                                Width="190"
                                Margin="0,0,12,8"
                                AutomationProperties.Name="Review status filter"
                                ItemsSource="{Binding ReviewStatusOptions}"
                                ToolTip="Review status"
                                SelectedItem="{Binding SelectedReviewStatus}" />
                            <Button
                                MinWidth="108"
                                Margin="0,0,0,8"
                                AutomationProperties.Name="Clear history filters"
                                Command="{Binding ClearFiltersCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Filter24" Style="{StaticResource AppIconStyle}" />
                                    <TextBlock Text="Clear" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="2" Padding="1" Style="{StaticResource SurfaceCardStyle}">
                        <Grid>
                            <DataGrid
                                x:Name="HistoryGrid"
                                AutomationProperties.Name="Completed training sessions"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                EnableColumnVirtualization="True"
                                EnableRowVirtualization="True"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                ItemsSource="{Binding Sessions}"
                                RowHeaderWidth="0"
                                SelectionMode="Single"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="150" Binding="{Binding CompletionTimeText}" Header="Completed" />
                                    <DataGridTextColumn Width="95" Binding="{Binding DurationText}" Header="Duration" />
                                    <DataGridTextColumn Width="90" Binding="{Binding TotalQuestions}" Header="Questions" />
                                    <DataGridTextColumn Width="70" Binding="{Binding UserGoodAnswers}" Header="GOOD" />
                                    <DataGridTextColumn Width="65" Binding="{Binding UserNgAnswers}" Header="NG" />
                                    <DataGridTextColumn Width="90" Binding="{Binding ReviewedAnswers}" Header="Reviewed" />
                                    <DataGridTextColumn Width="85" Binding="{Binding PendingAnswers}" Header="Pending" />
                                    <DataGridTextColumn Width="110" Binding="{Binding ReviewedAccuracyText}" Header="Accuracy*" />
                                    <DataGridTemplateColumn Width="155" Header="Review Status">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Margin="4">
                                                    <Border.Style>
                                                        <Style BasedOn="{StaticResource PendingChipStyle}" TargetType="Border">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ReviewStatusText}" Value="Reviewed">
                                                                    <Setter Property="Background" Value="{DynamicResource App.SuccessSurfaceBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ReviewStatusText}" Value="Partially Reviewed">
                                                                    <Setter Property="Background" Value="{DynamicResource App.InfoSurfaceBrush}" />
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource App.InfoBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource App.TextSecondaryBrush}"
                                                        Text="{Binding ReviewStatusText}" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="125" Header="Result">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button
                                                    MinWidth="96"
                                                    Margin="4"
                                                    AutomationProperties.Name="Open training result"
                                                    Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Content="View Result"
                                                    Style="{StaticResource DataGridOutlinedActionButtonStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Style="{StaticResource EmptyStateEntranceStyle}"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border
                                    Width="70"
                                    Height="70"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource App.SurfaceVariantBrush}"
                                    CornerRadius="22">
                                    <ui:SymbolIcon
                                        Width="38"
                                        Height="38"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource App.TextMutedBrush}"
                                        Symbol="History24" />
                                </Border>
                                <TextBlock
                                    Margin="0,14,0,0"
                                    FontSize="16"
                                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                                    Text="{Binding EmptyStateText}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Border
                                Background="{DynamicResource App.BusyScrimBrush}"
                                CornerRadius="15"
                                Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ProgressBar Width="220" Height="7" IsIndeterminate="True" />
                                    <TextBlock
                                        Margin="0,14,0,0"
                                        FontSize="16"
                                        Foreground="White"
                                        Text="Loading your training history..." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                Style="{StaticResource StatusMessageTextStyle}"
                                Text="{Binding StatusMessage}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource App.TextMutedBrush}"
                                Text="* Accuracy uses reviewed answers only; pending answers are excluded." />
                        </StackPanel>
                        <Button
                            Grid.Column="1"
                            MinWidth="138"
                            AutomationProperties.Name="Load more training sessions"
                            Command="{Binding LoadMoreCommand}"
                            Content="Load More"
                            Style="{StaticResource SecondaryActionButtonStyle}" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
