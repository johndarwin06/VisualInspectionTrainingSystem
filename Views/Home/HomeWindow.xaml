<Window
    x:Class="VisualInspectionTrainingSystem.Views.Home.HomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Home"
    Width="900"
    Height="620"
    MinWidth="620"
    MinHeight="520"
    AutomationProperties.Name="Training home"
    Background="{StaticResource App.LightMutedSurfaceBrush}"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Grid Margin="32" Style="{StaticResource ContentEntranceGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock
                    AutomationProperties.HeadingLevel="Level1"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{StaticResource App.LightTextBrush}"
                    Style="{StaticResource TrimmedTextWithToolTipStyle}"
                    Text="{Binding WelcomeMessage}" />
                <TextBlock
                    Margin="0,6,0,0"
                    Foreground="{StaticResource App.LightSecondaryTextBrush}"
                    Text="Choose a training size and begin when you are ready."
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Row="2"
                Padding="20,16"
                Background="{StaticResource App.LightSurfaceBrush}"
                BorderBrush="{StaticResource App.LightBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Style="{StaticResource InteractiveCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource App.LightTextBrush}"
                            Text="Quiz sample size" />
                        <TextBlock
                            Margin="0,5,0,0"
                            Foreground="{StaticResource App.LightSecondaryTextBrush}"
                            Text="Choose 10 or 20 unique inspection images for this training. If fewer images are available, every available image is used once."
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            Grid.Column="0"
                            TabIndex="0"
                            AutomationProperties.Name="10 question quiz"
                            Content="10 questions"
                            GroupName="QuizSize"
                            IsChecked="{Binding IsTenQuestionQuizSelected, Mode=TwoWay}" />
                        <RadioButton
                            Grid.Column="2"
                            TabIndex="1"
                            AutomationProperties.Name="20 question quiz"
                            Content="20 questions"
                            GroupName="QuizSize"
                            IsChecked="{Binding IsTwentyQuestionQuizSelected, Mode=TwoWay}" />
                        <TextBlock
                            Grid.Column="3"
                            Margin="20,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource App.AccentBrush}"
                            Text="{Binding QuizSizeSummary}"
                            TextWrapping="Wrap"
                            ToolTip="{Binding QuizSizeSummary}" />
                    </Grid>
                </Grid>
            </Border>

            <Button
                Grid.Row="4"
                TabIndex="2"
                AutomationProperties.Name="Start training"
                Command="{Binding StartTrainingCommand}"
                IsDefault="True"
                Style="{StaticResource PrimaryActionButtonStyle}"
                ToolTip="Start the selected quiz">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="PlayCircleOutline" Style="{StaticResource AppIconStyle}" />
                    <TextBlock VerticalAlignment="Center" Text="Start Training" />
                </StackPanel>
            </Button>

            <Button
                Grid.Row="6"
                TabIndex="3"
                AutomationProperties.HelpText="Open your completed training sessions and reviewed results."
                AutomationProperties.Name="Open my training history"
                Command="{Binding HistoryCommand}"
                Style="{StaticResource SecondaryActionButtonStyle}"
                ToolTip="Open your completed training sessions and reviewed results">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="History" Style="{StaticResource AppIconStyle}" />
                    <TextBlock VerticalAlignment="Center" Text="My Training History" />
                </StackPanel>
            </Button>

            <Button
                Grid.Row="8"
                TabIndex="4"
                AutomationProperties.Name="Open administration"
                Command="{Binding AdminCommand}"
                Style="{StaticResource SecondaryActionButtonStyle}"
                ToolTip="Open administrator tools"
                Visibility="{Binding AdminVisibility}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ShieldAccountOutline" Style="{StaticResource AppIconStyle}" />
                    <TextBlock VerticalAlignment="Center" Text="Administration" />
                </StackPanel>
            </Button>

            <Button
                Grid.Row="10"
                TabIndex="5"
                AutomationProperties.Name="Log out"
                Command="{Binding LogoutCommand}"
                Style="{StaticResource DangerActionButtonStyle}"
                ToolTip="Return to Login">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Logout" Style="{StaticResource AppIconStyle}" />
                    <TextBlock VerticalAlignment="Center" Text="Logout" />
                </StackPanel>
            </Button>
        </Grid>
    </ScrollViewer>
</Window>
