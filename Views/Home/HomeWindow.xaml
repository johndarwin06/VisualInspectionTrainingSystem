<ui:FluentWindow
    x:Class="VisualInspectionTrainingSystem.Views.Home.HomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Training Setup"
    Width="1120"
    Height="760"
    MinWidth="820"
    MinHeight="600"
    AutomationProperties.Name="Training setup"
    Background="{DynamicResource App.BackgroundBrush}"
    BorderBrush="{DynamicResource App.BorderBrush}"
    KeyboardNavigation.TabNavigation="Cycle"
    PreviewKeyDown="OnPreviewKeyDown"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    Style="{StaticResource FluentAppWindowStyle}"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        PanningMode="VerticalOnly"
        VerticalScrollBarVisibility="Auto">
        <Grid
            MaxWidth="1180"
            Margin="34,28,34,38"
            Style="{StaticResource ContentEntranceGridStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="22" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Task identity and authenticated profile context. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="BackButton"
                    Grid.Column="0"
                    MinWidth="146"
                    VerticalAlignment="Center"
                    AutomationProperties.HelpText="Close training setup and return to the trainee workspace."
                    AutomationProperties.Name="Back to trainee home"
                    Click="OnBackRequested"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    TabIndex="0"
                    ToolTip="Back to Home (Esc)">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowLeft24" Style="{StaticResource AppIconStyle}" />
                        <TextBlock VerticalAlignment="Center" Text="Back to Home" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock
                        AutomationProperties.ItemType="Heading"
                        Style="{StaticResource DisplayTitleTextStyle}"
                        Text="Training setup" />
                    <TextBlock
                        Margin="0,7,0,0"
                        FontSize="15"
                        Style="{StaticResource SupportingTextStyle}"
                        Text="Choose the session size, then begin one focused visual-inspection exercise."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Border
                    Grid.Column="4"
                    MinWidth="250"
                    Padding="16,12"
                    VerticalAlignment="Center"
                    Style="{StaticResource SurfaceCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="38"
                            Height="38"
                            VerticalAlignment="Center"
                            Background="{DynamicResource App.SecondarySurfaceBrush}"
                            CornerRadius="12">
                            <ui:SymbolIcon
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource App.PrimaryBrush}"
                                Symbol="Person24" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock
                                FontWeight="SemiBold"
                                Style="{StaticResource TrimmedTextWithToolTipStyle}"
                                Text="{Binding WelcomeMessage}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                Style="{StaticResource TrimmedTextWithToolTipStyle}"
                                Text="{Binding ProfileSummary}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource App.TextMutedBrush}"
                                Style="{StaticResource TrimmedTextWithToolTipStyle}"
                                Text="{Binding EmployeeNumberSummary}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- One primary task surface; global navigation remains in MainWindow. -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    MinHeight="365"
                    Padding="28"
                    Background="{DynamicResource App.NavigationBrush}"
                    BorderBrush="{DynamicResource App.NavigationRaisedBrush}"
                    BorderThickness="1"
                    CornerRadius="22"
                    >
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="24" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    AutomationProperties.ItemType="Heading"
                                    FontSize="25"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.DarkTextBrush}"
                                    Text="Start inspection training" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    MaxWidth="620"
                                    Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                                    Text="Inspect unique production images and classify each one as GOOD or NG. Your result opens when the session is complete."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Width="60"
                                Height="60"
                                Margin="18,0,0,0"
                                Background="{DynamicResource App.NavigationRaisedBrush}"
                                CornerRadius="18">
                                <ui:SymbolIcon
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource App.SecondaryBrush}"
                                    Symbol="Target24" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                                Text="SESSION SIZE" />
                            <WrapPanel>
                                <RadioButton
                                    TabIndex="1"
                                    Margin="0,0,10,10"
                                    AutomationProperties.HelpText="Select a short ten-question training session."
                                    AutomationProperties.Name="10 question quiz"
                                    Content="10 questions  &#x2022;  Quick"
                                    Foreground="{DynamicResource App.DarkTextBrush}"
                                    GroupName="QuizSize"
                                    IsChecked="{Binding IsTenQuestionQuizSelected, Mode=TwoWay}"
                                    Style="{StaticResource QuizSizeChoiceChipStyle}" />
                                <RadioButton
                                    TabIndex="2"
                                    Margin="0,0,0,10"
                                    AutomationProperties.HelpText="Select an extended twenty-question training session."
                                    AutomationProperties.Name="20 question quiz"
                                    Content="20 questions  &#x2022;  Extended"
                                    Foreground="{DynamicResource App.DarkTextBrush}"
                                    GroupName="QuizSize"
                                    IsChecked="{Binding IsTwentyQuestionQuizSelected, Mode=TwoWay}"
                                    Style="{StaticResource QuizSizeChoiceChipStyle}" />
                            </WrapPanel>
                        </StackPanel>

                        <Border
                            Grid.Row="4"
                            Padding="14,10"
                            Background="{DynamicResource App.NavigationRaisedBrush}"
                            CornerRadius="12">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource App.SecondaryBrush}"
                                    Symbol="Search24" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.DarkTextBrush}"
                                    Text="{Binding QuizSizeSummary}" />
                            </StackPanel>
                        </Border>

                        <Button
                            Grid.Row="6"
                            TabIndex="3"
                            MinWidth="210"
                            HorizontalAlignment="Right"
                            AutomationProperties.HelpText="Begin the selected inspection training session."
                            AutomationProperties.Name="Start training"
                            Command="{Binding StartTrainingCommand}"
                            IsDefault="True"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            ToolTip="Start the selected training session">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Play24" Style="{StaticResource AppIconStyle}" />
                                <TextBlock VerticalAlignment="Center" Text="Begin Training" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2">
                    <Border Margin="0,0,0,16" Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel>
                            <Border
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource App.InfoSurfaceBrush}"
                                CornerRadius="15">
                                <ui:SymbolIcon
                                    Width="26"
                                    Height="26"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource App.InfoBrush}"
                                    Symbol="Info24" />
                            </Border>
                            <TextBlock
                                Margin="0,16,0,0"
                                AutomationProperties.ItemType="Heading"
                                Style="{StaticResource SectionTitleTextStyle}"
                                Text="Before you start" />
                            <TextBlock
                                Margin="0,8,0,0"
                                Style="{StaticResource SupportingTextStyle}"
                                Text="Make sure each image is fully visible before choosing an answer."
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,10,0,0"
                                Style="{StaticResource SupportingTextStyle}"
                                Text="Use G for GOOD or N for NG when you prefer keyboard input."
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,10,0,0"
                                Style="{StaticResource SupportingTextStyle}"
                                Text="Do not close the application while an answer is being saved."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel>
                            <Border
                                Padding="10,5"
                                HorizontalAlignment="Left"
                                Style="{StaticResource GoodChipStyle}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.SuccessBrush}"
                                    Text="READY TO TRAIN" />
                            </Border>
                            <TextBlock
                                Margin="0,14,0,0"
                                FontWeight="SemiBold"
                                Text="Your progress stays with your account." />
                            <TextBlock
                                Margin="0,6,0,0"
                                Style="{StaticResource SupportingTextStyle}"
                                Text="Use My Progress in the main navigation to revisit completed sessions and reviewed outcomes."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Concise workflow guidance replaces duplicate navigation actions. -->
            <UniformGrid Grid.Row="4" Columns="3">
                <Border Margin="0,0,8,0" Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Width="29"
                            Height="29"
                            Foreground="{DynamicResource App.InfoBrush}"
                            Symbol="Search24" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock FontWeight="SemiBold" Text="1  &#x2022;  Inspect" />
                            <TextBlock
                                Margin="0,5,0,0"
                                Style="{StaticResource SupportingTextStyle}"
                                Text="Study the full image before deciding."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="4,0" Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Width="29"
                            Height="29"
                            Foreground="{DynamicResource App.SuccessBrush}"
                            Symbol="CheckmarkCircle24" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock FontWeight="SemiBold" Text="2  &#x2022;  Classify" />
                            <TextBlock
                                Margin="0,5,0,0"
                                Style="{StaticResource SupportingTextStyle}"
                                Text="Choose GOOD or NG once per image."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="8,0,0,0" Style="{StaticResource MetricCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Width="29"
                            Height="29"
                            Foreground="{DynamicResource App.WarningBrush}"
                            Symbol="CheckmarkCircle24" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock FontWeight="SemiBold" Text="3  &#x2022;  Review" />
                            <TextBlock
                                Margin="0,5,0,0"
                                Style="{StaticResource SupportingTextStyle}"
                                Text="Read the result and pending-review state."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>
        </Grid>
    </ScrollViewer>
</ui:FluentWindow>
