<Window
    x:Class="VisualInspectionTrainingSystem.Views.Home.HomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Training Workspace"
    Width="1180"
    Height="760"
    MinWidth="860"
    MinHeight="600"
    AutomationProperties.Name="Training home dashboard"
    Background="{DynamicResource App.BackgroundBrush}"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Application bar -->
        <Border
            Grid.Row="0"
            Padding="28,0"
            Background="{DynamicResource App.NavigationBrush}"
            materialDesign:ElevationAssist.Elevation="Dp6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Width="42"
                        Height="42"
                        Background="{DynamicResource App.SecondaryBrush}"
                        CornerRadius="12">
                        <materialDesign:PackIcon
                            Width="25"
                            Height="25"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Visual inspection training"
                            Foreground="White"
                            Kind="ImageSearchOutline" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            FontSize="17"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.DarkTextBrush}"
                            Text="VISUAL INSPECTION TRAINING" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                            Text="Trainee workspace" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Margin="0,0,14,0"
                        Padding="12,7"
                        Background="{DynamicResource App.NavigationRaisedBrush}"
                        CornerRadius="100">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Margin="0,0,7,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource App.SecondaryBrush}"
                                Kind="BadgeAccountHorizontalOutline" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource App.DarkTextBrush}"
                                Style="{StaticResource TrimmedTextWithToolTipStyle}"
                                Text="{Binding EmployeeNumberSummary}" />
                        </StackPanel>
                    </Border>
                    <Button
                        TabIndex="5"
                        AutomationProperties.Name="Log out"
                        Command="{Binding LogoutCommand}"
                        Style="{StaticResource DarkActionButtonStyle}"
                        ToolTip="Return to Login">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Logout" Style="{StaticResource AppIconStyle}" />
                            <TextBlock VerticalAlignment="Center" Text="Logout" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                MaxWidth="1380"
                Margin="32,28,32,36"
                Style="{StaticResource ContentEntranceGridStyle}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="26" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Welcome -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            Style="{StaticResource DisplayTitleTextStyle}"
                            Text="{Binding WelcomeMessage}" />
                        <TextBlock
                            Margin="0,7,0,0"
                            FontSize="15"
                            Foreground="{DynamicResource App.TextSecondaryBrush}"
                            Style="{StaticResource TrimmedTextWithToolTipStyle}"
                            Text="{Binding ProfileSummary}" />
                    </StackPanel>
                    <Border
                        Grid.Column="1"
                        Padding="13,8"
                        VerticalAlignment="Center"
                        Style="{StaticResource StatusChipStyle}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Margin="0,0,7,0"
                                Foreground="{DynamicResource App.SuccessBrush}"
                                Kind="CheckDecagramOutline" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                Text="Ready to train" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Primary dashboard actions -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.65*" MinWidth="460" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" MinWidth="290" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="26"
                        Background="{DynamicResource App.NavigationBrush}"
                        BorderBrush="{DynamicResource App.NavigationRaisedBrush}"
                        BorderThickness="1"
                        CornerRadius="20"
                        materialDesign:ElevationAssist.Elevation="Dp4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        AutomationProperties.HeadingLevel="Level2"
                                        FontSize="24"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource App.DarkTextBrush}"
                                        Text="Start inspection training" />
                                    <TextBlock
                                        Margin="0,7,0,0"
                                        MaxWidth="620"
                                        FontSize="14"
                                        Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                                        Text="Inspect unique production images, classify each one as GOOD or NG, and review your completed session afterward."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Border
                                    Grid.Column="1"
                                    Width="58"
                                    Height="58"
                                    Margin="20,0,0,0"
                                    Background="{DynamicResource App.NavigationRaisedBrush}"
                                    CornerRadius="18">
                                    <materialDesign:PackIcon
                                        Width="31"
                                        Height="31"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource App.SecondaryBrush}"
                                        Kind="TargetVariant" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="2">
                                <TextBlock
                                    Margin="0,0,0,10"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                                    Text="CHOOSE SESSION SIZE" />
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton
                                        TabIndex="0"
                                        Margin="0,0,10,0"
                                        Padding="18,9"
                                        AutomationProperties.Name="10 question quiz"
                                        Content="10 questions · Quick"
                                        Foreground="{DynamicResource App.DarkTextBrush}"
                                        GroupName="QuizSize"
                                        IsChecked="{Binding IsTenQuestionQuizSelected, Mode=TwoWay}"
                                        Style="{StaticResource QuizSizeChoiceChipStyle}" />
                                    <RadioButton
                                        TabIndex="1"
                                        Padding="18,9"
                                        AutomationProperties.Name="20 question quiz"
                                        Content="20 questions · Extended"
                                        Foreground="{DynamicResource App.DarkTextBrush}"
                                        GroupName="QuizSize"
                                        IsChecked="{Binding IsTwentyQuestionQuizSelected, Mode=TwoWay}"
                                        Style="{StaticResource QuizSizeChoiceChipStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                                    Text="{Binding QuizSizeSummary}" />
                                <Button
                                    Grid.Column="1"
                                    TabIndex="2"
                                    MinWidth="188"
                                    AutomationProperties.Name="Start training"
                                    Command="{Binding StartTrainingCommand}"
                                    IsDefault="True"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    ToolTip="Start the selected quiz">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlayCircleOutline" Style="{StaticResource AppIconStyle}" />
                                        <TextBlock VerticalAlignment="Center" Text="Begin Training" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2">
                        <Border
                            Margin="0,0,0,18"
                            Style="{StaticResource InteractiveCardStyle}">
                            <StackPanel>
                                <Border
                                    Width="46"
                                    Height="46"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource App.SecondarySurfaceBrush}"
                                    CornerRadius="14">
                                    <materialDesign:PackIcon
                                        Width="25"
                                        Height="25"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource App.InfoBrush}"
                                        Kind="History" />
                                </Border>
                                <TextBlock
                                    Margin="0,16,0,0"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource SectionTitleTextStyle}"
                                    Text="My Training History" />
                                <TextBlock
                                    Margin="0,7,0,16"
                                    Style="{StaticResource SupportingTextStyle}"
                                    Text="Review completed sessions, pending answers, accuracy, timing, and inspection images."
                                    TextWrapping="Wrap" />
                                <Button
                                    TabIndex="3"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.HelpText="Open your completed training sessions and reviewed results."
                                    AutomationProperties.Name="Open my training history"
                                    Command="{Binding HistoryCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    ToolTip="Open your completed training sessions and reviewed results">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ArrowRight" Style="{StaticResource AppIconStyle}" />
                                        <TextBlock VerticalAlignment="Center" Text="Open History" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border
                            Visibility="{Binding AdminVisibility}"
                            Style="{StaticResource InteractiveCardStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="42"
                                    Height="42"
                                    Background="{DynamicResource App.WarningSurfaceBrush}"
                                    CornerRadius="12">
                                    <materialDesign:PackIcon
                                        Width="23"
                                        Height="23"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource App.WarningBrush}"
                                        Kind="ShieldAccountOutline" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0">
                                    <TextBlock FontWeight="SemiBold" Text="Administration" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Style="{StaticResource SupportingTextStyle}"
                                        Text="Manage review and reporting" />
                                </StackPanel>
                                <Button
                                    Grid.Column="2"
                                    TabIndex="4"
                                    MinWidth="44"
                                    Padding="9"
                                    AutomationProperties.Name="Open administration"
                                    Command="{Binding AdminCommand}"
                                    Style="{StaticResource AppIconButtonStyle}"
                                    ToolTip="Open administrator tools">
                                    <materialDesign:PackIcon Kind="ArrowRight" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Process summary -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Width="30"
                                Height="30"
                                Foreground="{DynamicResource App.PrimaryBrush}"
                                Kind="ImageSearchOutline" />
                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                <TextBlock FontWeight="SemiBold" Text="1 · Inspect" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource SupportingTextStyle}" Text="Study the full image without distortion." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Width="30"
                                Height="30"
                                Foreground="{DynamicResource App.SuccessBrush}"
                                Kind="CheckCircleOutline" />
                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                <TextBlock FontWeight="SemiBold" Text="2 · Classify" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource SupportingTextStyle}" Text="Select GOOD or NG using buttons or shortcuts." />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource MetricCardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Width="30"
                                Height="30"
                                Foreground="{DynamicResource App.WarningBrush}"
                                Kind="ClipboardCheckOutline" />
                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                <TextBlock FontWeight="SemiBold" Text="3 · Review" />
                                <TextBlock Margin="0,5,0,0" Style="{StaticResource SupportingTextStyle}" Text="Track reviewed accuracy and pending answers." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
