<ui:FluentWindow
    x:Class="VisualInspectionTrainingSystem.Views.Quiz.QuizWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:progress="clr-namespace:VisualInspectionTrainingSystem.Controls.Progress"
    Title="Visual Inspection Training"
    Width="1500"
    Height="900"
    MinWidth="900"
    MinHeight="650"
    AutomationProperties.Name="Visual inspection quiz"
    Background="{DynamicResource App.DarkBackgroundBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    Style="{StaticResource FluentAppWindowStyle}"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.Resources>
        <Style
            x:Key="GoodQuizButtonStyle"
            BasedOn="{StaticResource PrimaryActionButtonStyle}"
            TargetType="Button">
            <Setter Property="MinHeight" Value="116" />
            <Setter Property="Background" Value="{DynamicResource App.SuccessBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.SuccessBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style
            x:Key="NgQuizButtonStyle"
            BasedOn="{StaticResource GoodQuizButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource App.DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Margin="22" Style="{StaticResource ContentEntranceGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="104" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" MinHeight="116" />
        </Grid.RowDefinitions>

        <!-- Session header -->
        <Border
            Grid.Row="0"
            Padding="24,18"
            Background="{DynamicResource App.DarkSurfaceBrush}"
            BorderBrush="{DynamicResource App.DarkBorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="390" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Width="58"
                        Height="58"
                        Margin="0,0,18,0"
                        Background="{DynamicResource App.NavigationRaisedBrush}"
                        CornerRadius="18">
                        <ui:SymbolIcon
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource App.SecondaryBrush}"
                            Symbol="Search24" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level1"
                            FontFamily="Segoe UI Variable Display, Segoe UI"
                            FontSize="27"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.DarkTextBrush}"
                            Text="Visual Inspection Training" />
                        <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                            <TextBlock Foreground="{DynamicResource App.DarkSecondaryTextBrush}" Text="Trainee" />
                            <TextBlock
                                Margin="10,0,0,0"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource App.DarkTextBrush}"
                                Style="{StaticResource TrimmedTextWithToolTipStyle}"
                                Text="{Binding CurrentUser}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,4,0,0"
                            AutomationProperties.LiveSetting="Polite"
                            Foreground="{DynamicResource App.SecondaryBrush}"
                            Text="{Binding QuizNotice}" />
                    </StackPanel>
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="18,13"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Background="{DynamicResource App.DarkRaisedSurfaceBrush}"
                    BorderBrush="{DynamicResource App.DarkBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="48"
                            Height="48"
                            Margin="0,0,14,0"
                            Background="{DynamicResource App.NavigationBrush}"
                            CornerRadius="14">
                            <ui:SymbolIcon
                                Width="25"
                                Height="25"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource App.SecondaryBrush}"
                                Symbol="CheckmarkCircle24" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <Grid>
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                                    Text="QUESTION PROGRESS" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource App.SecondaryBrush}"
                                    Text="{Binding QuestionProgressText}" />
                            </Grid>
                            <ProgressBar
                                Height="8"
                                Margin="0,7,0,0"
                                Maximum="100"
                                Value="{Binding CompletionPercentage, Mode=OneWay}" />
                            <Grid Margin="0,5,0,0">
                                <TextBlock
                                    Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                                    Text="{Binding AnsweredRemainingText}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.DarkTextBrush}"
                                    Text="{Binding CompletionPercentage, StringFormat={}{0:0}%}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Inspection stage -->
        <Border
            Grid.Row="2"
            Padding="16"
            Background="{DynamicResource App.DarkSurfaceBrush}"
            BorderBrush="{DynamicResource App.DarkBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            >
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="4,0">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:SymbolIcon
                            Width="22"
                            Height="22"
                            Margin="0,0,10,0"
                            Foreground="{DynamicResource App.SecondaryBrush}"
                            Symbol="Image24" />
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource App.DarkTextBrush}"
                                Text="INSPECTION IMAGE" />
                            <TextBlock
                                Margin="0,2,0,0"
                                AutomationProperties.LiveSetting="Polite"
                                FontSize="12"
                                Foreground="{DynamicResource App.DarkSecondaryTextBrush}"
                                Text="{Binding ImageStatus}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Margin="0,0,8,0" Padding="10,5" Background="{DynamicResource App.DarkRaisedSurfaceBrush}" CornerRadius="100">
                            <TextBlock Foreground="{DynamicResource App.DarkSecondaryTextBrush}" Text="G  ·  GOOD" />
                        </Border>
                        <Border Margin="0,0,8,0" Padding="10,5" Background="{DynamicResource App.DarkRaisedSurfaceBrush}" CornerRadius="100">
                            <TextBlock Foreground="{DynamicResource App.DarkSecondaryTextBrush}" Text="N  ·  NG" />
                        </Border>
                        <Border Padding="10,5" Background="{DynamicResource App.DarkRaisedSurfaceBrush}" CornerRadius="100">
                            <TextBlock Foreground="{DynamicResource App.DarkSecondaryTextBrush}" Text="ESC  ·  Exit" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="1"
                    Background="#03070B"
                    BorderBrush="{DynamicResource App.DarkBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid>
                        <Image
                            Margin="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Current inspection image"
                            Source="{Binding CurrentImage}"
                            Stretch="Uniform">
                            <Image.Triggers>
                                <EventTrigger RoutedEvent="Image.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Image.Triggers>
                        </Image>
                        <progress:ModernProgressBar
                            Panel.ZIndex="100"
                            IsActive="{Binding IsImageLoading}"
                            Message="Loading inspection image..." />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Classification actions -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                AutomationProperties.HelpText="Classify the image as GOOD. Keyboard shortcut G."
                AutomationProperties.Name="GOOD answer"
                Command="{Binding GoodCommand}"
                Style="{StaticResource GoodQuizButtonStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="58"
                        Height="58"
                        Background="#26FFFFFF"
                        CornerRadius="18">
                        <ui:SymbolIcon
                            Width="34"
                            Height="34"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Symbol="Checkmark24" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock FontSize="30" FontWeight="Bold" Text="GOOD" />
                        <TextBlock Margin="0,3,0,0" FontSize="14" Text="Acceptable appearance" />
                    </StackPanel>
                    <Border Grid.Column="2" Padding="13,7" VerticalAlignment="Center" Background="#26FFFFFF" CornerRadius="100">
                        <TextBlock FontWeight="SemiBold" Text="Press G" />
                    </Border>
                </Grid>
            </Button>

            <Button
                Grid.Column="2"
                AutomationProperties.HelpText="Classify the image as NG. Keyboard shortcut N."
                AutomationProperties.Name="NG answer"
                Command="{Binding NgCommand}"
                Style="{StaticResource NgQuizButtonStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="58"
                        Height="58"
                        Background="#26FFFFFF"
                        CornerRadius="18">
                        <ui:SymbolIcon
                            Width="34"
                            Height="34"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Symbol="Dismiss20" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                        <TextBlock FontSize="30" FontWeight="Bold" Text="NG" />
                        <TextBlock Margin="0,3,0,0" FontSize="14" Text="Nonconforming appearance" />
                    </StackPanel>
                    <Border Grid.Column="2" Padding="13,7" VerticalAlignment="Center" Background="#26FFFFFF" CornerRadius="100">
                        <TextBlock FontWeight="SemiBold" Text="Press N" />
                    </Border>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</ui:FluentWindow>
