<ui:FluentWindow
    x:Class="VisualInspectionTrainingSystem.Views.Quiz.QuizWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:progress="clr-namespace:VisualInspectionTrainingSystem.Controls.Progress"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Visual Inspection Training"
    Width="1440"
    Height="880"
    MinWidth="980"
    MinHeight="700"
    AutomationProperties.Name="Visual inspection quiz"
    Background="{DynamicResource App.BackgroundBrush}"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    KeyboardNavigation.TabNavigation="Cycle"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    Style="{StaticResource FluentAppWindowStyle}"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <ui:FluentWindow.Resources>
        <Style x:Key="QuizChoiceButtonBaseStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="128" />
            <Setter Property="Padding" Value="24,16" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ChoiceBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18"
                            RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource App.PrimaryBrush}" />
                                <Setter Property="BorderThickness" Value="4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChoiceBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChoiceBorder" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="GoodQuizButtonStyle"
            BasedOn="{StaticResource QuizChoiceButtonBaseStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource App.SuccessSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.SuccessBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource App.SuccessBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.SuccessBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.SuccessBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style
            x:Key="NgQuizButtonStyle"
            BasedOn="{StaticResource QuizChoiceButtonBaseStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource App.DangerSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource App.DangerBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.DangerBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource App.DangerBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuizShortcutChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{DynamicResource App.SurfaceVariantBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="100" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Margin="28,24,28,28" Style="{StaticResource ContentEntranceGridStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fluent session identity and progress summary. -->
        <ui:Card Grid.Row="0" Padding="22,18" Style="{StaticResource FluentSurfaceCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <Border
                        Width="58"
                        Height="58"
                        Margin="0,0,18,0"
                        Background="{DynamicResource App.InfoSurfaceBrush}"
                        CornerRadius="17">
                        <ui:SymbolIcon
                            Width="31"
                            Height="31"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource App.InfoBrush}"
                            Symbol="Search24" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            AutomationProperties.ItemType="Heading"
                            FontFamily="Segoe UI Variable Display, Segoe UI"
                            FontSize="27"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.TextPrimaryBrush}"
                            Text="Visual Inspection Training" />
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <Border Margin="0,0,10,0" Padding="9,4" Style="{StaticResource StatusChipStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="15"
                                        Height="15"
                                        Margin="0,0,6,0"
                                        Foreground="{DynamicResource App.PrimaryBrush}"
                                        Symbol="Person24" />
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource App.TextPrimaryBrush}"
                                        Text="{Binding CurrentUser}" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                AutomationProperties.ItemType="Status"
                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                Text="{Binding QuizNotice}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border
                    Grid.Column="2"
                    Padding="16,12"
                    Background="{DynamicResource App.SurfaceVariantBrush}"
                    BorderBrush="{DynamicResource App.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="54"
                            Height="54"
                            Background="{DynamicResource App.PrimaryBrush}"
                            CornerRadius="16">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding CurrentQuestion}" />
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Grid>
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                                    Text="QUESTION PROGRESS" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.PrimaryBrush}"
                                    Text="{Binding QuestionProgressText}" />
                            </Grid>
                            <ProgressBar
                                Height="8"
                                Margin="0,7,0,0"
                                Maximum="100"
                                Value="{Binding CompletionPercentage, Mode=OneWay}" />
                            <Grid Margin="0,5,0,0">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource App.TextSecondaryBrush}"
                                    Text="{Binding AnsweredRemainingText}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource App.TextPrimaryBrush}"
                                    Text="{Binding CompletionPercentage, StringFormat={}{0:0}%}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ui:Card>

        <!-- The inspection image remains the dominant visual surface. -->
        <Border Grid.Row="2" Padding="18" Style="{StaticResource SurfaceCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Border
                            Width="42"
                            Height="42"
                            Margin="0,0,12,0"
                            Background="{DynamicResource App.InfoSurfaceBrush}"
                            CornerRadius="12">
                            <ui:SymbolIcon
                                Width="23"
                                Height="23"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource App.InfoBrush}"
                                Symbol="Image24" />
                        </Border>
                        <StackPanel>
                            <TextBlock
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource App.TextPrimaryBrush}"
                                Text="Inspection image" />
                            <TextBlock
                                Margin="0,2,0,0"
                                AutomationProperties.ItemType="Status"
                                FontSize="12"
                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                Text="{Binding ImageStatus}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border Margin="0,0,8,0" Style="{StaticResource QuizShortcutChipStyle}">
                            <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}" Text="G  &#x2022;  GOOD" />
                        </Border>
                        <Border Margin="0,0,8,0" Style="{StaticResource QuizShortcutChipStyle}">
                            <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}" Text="N  &#x2022;  NG" />
                        </Border>
                        <Border Style="{StaticResource QuizShortcutChipStyle}">
                            <TextBlock Foreground="{DynamicResource App.TextSecondaryBrush}" Text="ESC  &#x2022;  Exit safely" />
                        </Border>
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="2"
                    MinHeight="330"
                    Background="{DynamicResource App.NavigationBrush}"
                    BorderBrush="{DynamicResource App.NavigationRaisedBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                    <Grid Margin="14">
                        <Border Background="#080C12" CornerRadius="11">
                            <Image
                                Margin="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Current inspection image"
                                Source="{Binding CurrentImage}"
                                Stretch="Uniform">
                                <Image.Triggers>
                                    <EventTrigger RoutedEvent="Image.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="0.35"
                                                    To="1"
                                                    Duration="0:0:0.16" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Image.Triggers>
                            </Image>
                        </Border>
                        <progress:ModernProgressBar
                            Panel.ZIndex="100"
                            IsActive="{Binding IsImageLoading}"
                            Message="Loading inspection image..." />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Large semantic choice cards support pointer and rapid keyboard work. -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                Grid.Column="0"
                AutomationProperties.HelpText="Classify the image as GOOD. Keyboard shortcut G."
                AutomationProperties.Name="GOOD answer"
                Command="{Binding GoodCommand}"
                Style="{StaticResource GoodQuizButtonStyle}"
                TabIndex="0"
                ToolTip="Classify as GOOD (G)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="66"
                        Height="66"
                        Background="{DynamicResource App.SurfaceVariantBrush}"
                        BorderBrush="{DynamicResource App.SuccessBrush}"
                        BorderThickness="2"
                        CornerRadius="20">
                        <ui:SymbolIcon
                            Width="38"
                            Height="38"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource App.SuccessBrush}"
                            Symbol="CheckmarkCircle24" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                        <TextBlock FontSize="29" FontWeight="Bold" Text="GOOD" />
                        <TextBlock Margin="0,3,0,0" FontSize="14" Text="Acceptable appearance" />
                        <TextBlock Margin="0,5,0,0" FontSize="11" Opacity="0.78" Text="Confirm this image meets the inspection standard." TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="2" Padding="13,7" VerticalAlignment="Center" Background="{DynamicResource App.SurfaceVariantBrush}" CornerRadius="100">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource App.SuccessBrush}" Text="Press G" />
                    </Border>
                </Grid>
            </Button>

            <Button
                Grid.Column="2"
                AutomationProperties.HelpText="Classify the image as NG. Keyboard shortcut N."
                AutomationProperties.Name="NG answer"
                Command="{Binding NgCommand}"
                Style="{StaticResource NgQuizButtonStyle}"
                TabIndex="1"
                ToolTip="Classify as NG (N)">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="66"
                        Height="66"
                        Background="{DynamicResource App.SurfaceVariantBrush}"
                        BorderBrush="{DynamicResource App.DangerBrush}"
                        BorderThickness="2"
                        CornerRadius="8">
                        <ui:SymbolIcon
                            Width="38"
                            Height="38"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource App.DangerBrush}"
                            Symbol="Warning24" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                        <TextBlock FontSize="29" FontWeight="Bold" Text="NG" />
                        <TextBlock Margin="0,3,0,0" FontSize="14" Text="Nonconforming appearance" />
                        <TextBlock Margin="0,5,0,0" FontSize="11" Opacity="0.78" Text="Flag a visible defect or unacceptable condition." TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="2" Padding="13,7" VerticalAlignment="Center" Background="{DynamicResource App.SurfaceVariantBrush}" CornerRadius="100">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource App.DangerBrush}" Text="Press N" />
                    </Border>
                </Grid>
            </Button>
        </Grid>
    </Grid>
</ui:FluentWindow>
