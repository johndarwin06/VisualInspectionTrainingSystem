<ui:FluentWindow
    x:Class="VisualInspectionTrainingSystem.Views.Dialogs.ApplicationDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Visual Inspection Training System"
    Width="520"
    MinWidth="420"
    MaxWidth="680"
    MaxHeight="620"
    AutomationProperties.Name="Application message"
    Background="{DynamicResource App.BackgroundBrush}"
    ExtendsContentIntoTitleBar="True"
    PreviewKeyDown="OnPreviewKeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    Style="{StaticResource FluentAppWindowStyle}"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Grid.Row="0"
            Icon="{ui:SymbolIcon Info24}"
            Style="{StaticResource FluentAppTitleBarStyle}"
            Title="Visual Inspection Training System" />

        <ui:Card
            Grid.Row="1"
            Margin="14,0,14,14"
            Style="{StaticResource FluentElevatedCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="28,28,28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="52" Height="52" VerticalAlignment="Top" Background="{DynamicResource App.InfoSurfaceBrush}" CornerRadius="16">
                        <ui:SymbolIcon
                            x:Name="DialogIcon"
                            Width="27"
                            Height="27"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Dialog status"
                            Foreground="{DynamicResource App.PrimaryBrush}"
                            Symbol="Info24" />
                    </Border>

                    <StackPanel Grid.Column="2">
                        <TextBlock
                            x:Name="CaptionText"
                            AutomationProperties.HeadingLevel="Level1"
                            FontSize="21"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource App.TextPrimaryBrush}"
                            TextWrapping="Wrap" />
                        <ScrollViewer Margin="0,10,0,0" MaxHeight="320" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                x:Name="MessageText"
                                AutomationProperties.LiveSetting="Assertive"
                                Foreground="{DynamicResource App.TextSecondaryBrush}"
                                LineHeight="22"
                                TextWrapping="Wrap" />
                        </ScrollViewer>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Padding="20,16" Background="{DynamicResource App.SurfaceVariantBrush}" BorderBrush="{DynamicResource App.DividerBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <ui:Button x:Name="TertiaryButton" MinWidth="88" Margin="0,0,10,0" Appearance="Secondary" Click="OnResultButtonClick" />
                        <ui:Button x:Name="SecondaryButton" MinWidth="88" Margin="0,0,10,0" Appearance="Secondary" Click="OnResultButtonClick" />
                        <ui:Button x:Name="PrimaryButton" MinWidth="88" Appearance="Primary" Click="OnResultButtonClick" IsDefault="True" />
                    </StackPanel>
                </Border>
            </Grid>
        </ui:Card>
    </Grid>
</ui:FluentWindow>
