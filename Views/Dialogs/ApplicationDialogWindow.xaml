<Window
    x:Class="VisualInspectionTrainingSystem.Views.Dialogs.ApplicationDialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Visual Inspection Training System"
    Width="520"
    MinWidth="420"
    MaxWidth="680"
    MaxHeight="620"
    AutomationProperties.Name="Application message"
    Padding="0"
    Background="{StaticResource App.LightMutedSurfaceBrush}"
    PreviewKeyDown="OnPreviewKeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner">

    <Border
        Background="{StaticResource App.LightSurfaceBrush}"
        BorderBrush="{StaticResource App.LightBorderBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="28,26,28,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="44"
                    Height="44"
                    VerticalAlignment="Top"
                    Background="#E6F0F8"
                    CornerRadius="22">
                    <materialDesign:PackIcon
                        x:Name="DialogIcon"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Dialog status"
                        Foreground="{StaticResource App.AccentBrush}"
                        Kind="InformationOutline" />
                </Border>

                <StackPanel Grid.Column="2">
                    <TextBlock
                        x:Name="CaptionText"
                        AutomationProperties.HeadingLevel="Level1"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource App.LightTextBrush}"
                        TextWrapping="Wrap" />
                    <ScrollViewer
                        Margin="0,10,0,0"
                        MaxHeight="320"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="MessageText"
                            AutomationProperties.LiveSetting="Assertive"
                            Foreground="{StaticResource App.LightSecondaryTextBrush}"
                            LineHeight="22"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                Padding="20,16"
                Background="#F8FAFC"
                BorderBrush="{StaticResource App.LightBorderBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        x:Name="TertiaryButton"
                        Margin="0,0,10,0"
                        Click="OnResultButtonClick"
                        Style="{StaticResource SecondaryActionButtonStyle}" />
                    <Button
                        x:Name="SecondaryButton"
                        Margin="0,0,10,0"
                        Click="OnResultButtonClick"
                        Style="{StaticResource SecondaryActionButtonStyle}" />
                    <Button
                        x:Name="PrimaryButton"
                        Click="OnResultButtonClick"
                        IsDefault="True"
                        Style="{StaticResource PrimaryActionButtonStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
