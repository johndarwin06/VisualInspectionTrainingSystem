<Window
    x:Class="VisualInspectionTrainingSystem.Views.LoadingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:progress="clr-namespace:VisualInspectionTrainingSystem.Controls.Progress"
    Title="Working - Visual Inspection Training System"
    Width="460"
    Height="240"
    AutomationProperties.Name="Operation in progress"
    Background="{StaticResource App.DarkBackgroundBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid>
        <progress:ModernProgressBar
            IsActive="True"
            Message="Please wait while the operation completes..." />
    </Grid>
</Window>
