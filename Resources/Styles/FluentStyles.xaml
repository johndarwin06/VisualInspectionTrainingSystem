<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- Fluent window and title-bar foundation used only by migrated views. -->
    <Style x:Key="FluentAppWindowStyle" BasedOn="{StaticResource DefaultFluentWindowStyle}" TargetType="{x:Type ui:FluentWindow}">
        <Setter Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
        <Setter Property="ExtendsContentIntoTitleBar" Value="True" />
        <Setter Property="WindowBackdropType" Value="Mica" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="FluentAppTitleBarStyle" BasedOn="{StaticResource {x:Type ui:TitleBar}}" TargetType="{x:Type ui:TitleBar}">
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="16,0,8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
    </Style>

    <!-- Reusable command styles keep migrated screens consistent. -->
    <Style x:Key="FluentPrimaryButtonStyle" BasedOn="{StaticResource DefaultUiButtonStyle}" TargetType="{x:Type ui:Button}">
        <Setter Property="Appearance" Value="Primary" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FluentSecondaryButtonStyle" BasedOn="{StaticResource DefaultUiButtonStyle}" TargetType="{x:Type ui:Button}">
        <Setter Property="Appearance" Value="Secondary" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FluentDangerButtonStyle" BasedOn="{StaticResource DefaultUiButtonStyle}" TargetType="{x:Type ui:Button}">
        <Setter Property="Appearance" Value="Danger" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="FluentToolbarButtonStyle" BasedOn="{StaticResource DefaultUiButtonStyle}" TargetType="{x:Type ui:Button}">
        <Setter Property="Appearance" Value="Secondary" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="12,6" />
    </Style>

    <Style x:Key="FluentIconButtonStyle" BasedOn="{StaticResource DefaultUiButtonStyle}" TargetType="{x:Type ui:Button}">
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <!-- Native WPF-UI input controls provide Fluent validation and focus visuals. -->
    <Style x:Key="FluentTextBoxStyle" BasedOn="{StaticResource DefaultUiTextBoxStyle}" TargetType="{x:Type ui:TextBox}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="ClearButtonEnabled" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="FluentPasswordBoxStyle" BasedOn="{StaticResource DefaultUiPasswordBoxStyle}" TargetType="{x:Type ui:PasswordBox}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="RevealButtonEnabled" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="FluentComboBoxStyle" BasedOn="{StaticResource DefaultComboBoxStyle}" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Surface and navigation styles use the existing theme-neutral semantic tokens. -->
    <Style x:Key="FluentSurfaceCardStyle" BasedOn="{StaticResource {x:Type ui:Card}}" TargetType="{x:Type ui:Card}">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="FluentCompactCardStyle" BasedOn="{StaticResource FluentSurfaceCardStyle}" TargetType="{x:Type ui:Card}">
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="FluentElevatedCardStyle" BasedOn="{StaticResource FluentSurfaceCardStyle}" TargetType="{x:Type ui:Card}">
        <Setter Property="BorderBrush" Value="{DynamicResource App.DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="FluentChartCardStyle" BasedOn="{StaticResource FluentSurfaceCardStyle}" TargetType="{x:Type ui:Card}">
        <Setter Property="MinHeight" Value="300" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="FluentNavigationViewStyle" BasedOn="{StaticResource DefaultNavigationViewStyle}" TargetType="{x:Type ui:NavigationView}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="PaneDisplayMode" Value="LeftFluent" />
        <Setter Property="IsBackButtonVisible" Value="Collapsed" />
        <Setter Property="IsPaneToggleVisible" Value="True" />
        <Setter Property="IsPaneOpen" Value="True" />
        <Setter Property="OpenPaneLength" Value="280" />
        <Setter Property="CompactPaneLength" Value="52" />
        <Setter Property="IsFooterSeparatorVisible" Value="True" />
        <Setter Property="TransitionDuration" Value="160" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="False">
                <Setter Property="TransitionDuration" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FluentNavigationItemStyle" BasedOn="{StaticResource NavigationViewItemDefaultStyle}" TargetType="{x:Type ui:NavigationViewItem}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <!-- Data-heavy pages retain native sorting, selection, and recycling. -->
    <Style x:Key="FluentDataGridStyle" BasedOn="{StaticResource DefaultUiDataGridStyle}" TargetType="{x:Type ui:DataGrid}">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="True" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="RowHeight" Value="44" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <!-- Status badges intentionally distinguish NG from Wrong. -->
    <Style x:Key="FluentStatusBadgeStyle" TargetType="Border">
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource App.SurfaceVariantBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="FluentGoodBadgeStyle" BasedOn="{StaticResource FluentStatusBadgeStyle}" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.SuccessSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.SuccessBrush}" />
    </Style>

    <Style x:Key="FluentNgBadgeStyle" BasedOn="{StaticResource FluentStatusBadgeStyle}" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.WarningSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.WarningBrush}" />
    </Style>

    <Style x:Key="FluentPendingBadgeStyle" BasedOn="{StaticResource FluentStatusBadgeStyle}" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.InfoSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.InfoBrush}" />
    </Style>

    <Style x:Key="FluentWrongBadgeStyle" BasedOn="{StaticResource FluentStatusBadgeStyle}" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.DangerSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" />
    </Style>

</ResourceDictionary>
