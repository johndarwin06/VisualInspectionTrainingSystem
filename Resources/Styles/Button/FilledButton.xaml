<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Optional filled action style with a Fluent template. -->
    <Style
        x:Key="FilledButtonStyle"
        BasedOn="{StaticResource DefaultButtonStyle}"
        TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource App.OnPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource App.PrimaryBrush}" />
    </Style>

</ResourceDictionary>
