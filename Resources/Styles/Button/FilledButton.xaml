<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Optional filled action style with a unique key and official Material template. -->
    <Style
        x:Key="FilledButtonStyle"
        BasedOn="{StaticResource MaterialDesignRaisedButton}"
        TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource App.OnPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource App.PrimaryBrush}" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12" />
    </Style>

</ResourceDictionary>
