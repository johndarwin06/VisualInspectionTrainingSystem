<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!-- Material raised primary action retained under the legacy public key. -->
    <Style
        x:Key="PrimaryButtonStyle"
        BasedOn="{StaticResource MaterialDesignRaisedButton}"
        TargetType="{x:Type Button}">
        <Setter Property="Height" Value="44" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="Padding" Value="20,8" />
        <Setter Property="Background" Value="{DynamicResource App.PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.OnPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="12" />
    </Style>

</ResourceDictionary>
