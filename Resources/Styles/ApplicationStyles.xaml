<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <!-- Accessibility and control foundation. -->
    <Style x:Key="AppFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="2" BorderBrush="{DynamicResource App.FocusBrush}" BorderThickness="2" CornerRadius="6" SnapsToDevicePixels="True">
                        <AdornedElementPlaceholder />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource App.BackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="AccessibleButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="MinWidth" Value="96" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>

    <Style x:Key="PrimaryActionButtonStyle" BasedOn="{StaticResource AccessibleButtonStyle}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource App.PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.OnPrimaryBrush}" />
    </Style>

    <Style x:Key="SecondaryActionButtonStyle" BasedOn="{StaticResource AccessibleButtonStyle}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
    </Style>

    <Style x:Key="DarkActionButtonStyle" BasedOn="{StaticResource AccessibleButtonStyle}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource App.NavigationRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.DarkBorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.DarkTextBrush}" />
    </Style>

    <Style x:Key="DangerActionButtonStyle" BasedOn="{StaticResource AccessibleButtonStyle}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource App.DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <Style x:Key="ShellNavigationButtonStyle" BasedOn="{StaticResource AccessibleButtonStyle}" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.DarkSecondaryTextBrush}" />
    </Style>

    <Style x:Key="ActiveShellNavigationButtonStyle" BasedOn="{StaticResource ShellNavigationButtonStyle}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource App.NavigationRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.DarkTextBrush}" />
    </Style>

    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource AccessibleButtonStyle}" />

    <Style x:Key="IconButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
    </Style>

    <!-- Native controls inherit WPF-UI templates while retaining established keys. -->
    <Style x:Key="AccessibleTextBoxStyle" TargetType="{x:Type TextBox}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
    </Style>
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource AccessibleTextBoxStyle}" />

    <Style x:Key="AccessiblePasswordBoxStyle" TargetType="{x:Type PasswordBox}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
    </Style>
    <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource AccessiblePasswordBoxStyle}" />

    <Style x:Key="AccessibleComboBoxStyle" BasedOn="{StaticResource DefaultComboBoxStyle}" TargetType="{x:Type ComboBox}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
    </Style>
    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource AccessibleComboBoxStyle}" />

    <Style x:Key="AccessibleDatePickerStyle" TargetType="{x:Type DatePicker}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
    </Style>
    <Style TargetType="{x:Type DatePicker}" BasedOn="{StaticResource AccessibleDatePickerStyle}" />

    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
    </Style>
    <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
    </Style>
    <Style x:Key="QuizSizeChoiceChipStyle" TargetType="{x:Type RadioButton}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisualStyle}" />
    </Style>

    <!-- Data controls retain sorting, virtualization, selection, and scrolling. -->
    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="True" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="EnableColumnVirtualization" Value="True" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="RowHeight" Value="44" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>
    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource App.SurfaceVariantBrush}" />
    </Style>
    <Style x:Key="DataGridActionButtonStyle" BasedOn="{StaticResource AccessibleButtonStyle}" TargetType="{x:Type Button}">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="MinWidth" Value="78" />
        <Setter Property="Padding" Value="12,5" />
    </Style>
    <Style x:Key="DataGridOutlinedActionButtonStyle" BasedOn="{StaticResource DataGridActionButtonStyle}" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.PrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.PrimaryBrush}" />
    </Style>
    <Style x:Key="DataGridDangerActionButtonStyle" BasedOn="{StaticResource DataGridActionButtonStyle}" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource App.DangerBrush}" />
    </Style>

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="Padding" Value="10,7" />
    </Style>

    <!-- Typography. -->
    <Style x:Key="DisplayTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
    </Style>
    <Style x:Key="PageTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
    </Style>
    <Style x:Key="SectionTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
    </Style>
    <Style x:Key="SupportingTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="MetricValueTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextPrimaryBrush}" />
    </Style>

    <!-- Semantic surfaces. -->
    <Style x:Key="SurfaceCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="{DynamicResource App.SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>
    <Style x:Key="MetricCardStyle" BasedOn="{StaticResource SurfaceCardStyle}" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="18" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style x:Key="InteractiveCardStyle" BasedOn="{StaticResource SurfaceCardStyle}" TargetType="{x:Type Border}">
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style x:Key="FilterBarStyle" BasedOn="{StaticResource SurfaceCardStyle}" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style x:Key="NavigationRailStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource App.NavigationBrush}" />
        <Setter Property="CornerRadius" Value="0,20,20,0" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="AuthenticatedShellNavigationRailStyle" BasedOn="{StaticResource NavigationRailStyle}" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="20,24" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.NavigationRaisedBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>
    <Style x:Key="ShellProfileCardStyle" BasedOn="{StaticResource FluentSurfaceCardStyle}" TargetType="{x:Type ui:Card}">
        <Setter Property="MinHeight" Value="76" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="Background" Value="{DynamicResource App.NavigationRaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource App.DarkTextBrush}" />
    </Style>

    <!-- Status chips distinguish trainee classification from review correctness. -->
    <Style x:Key="StatusChipStyle" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="100" />
        <Setter Property="Background" Value="{DynamicResource App.SurfaceVariantBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="GoodChipStyle" BasedOn="{StaticResource StatusChipStyle}" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource App.SuccessSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.SuccessBrush}" />
    </Style>
    <Style x:Key="NgChipStyle" BasedOn="{StaticResource StatusChipStyle}" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource App.DangerSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.DangerBrush}" />
    </Style>
    <Style x:Key="PendingChipStyle" BasedOn="{StaticResource StatusChipStyle}" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource App.WarningSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.WarningBrush}" />
    </Style>
    <Style x:Key="CorrectChipStyle" BasedOn="{StaticResource GoodChipStyle}" TargetType="{x:Type Border}" />
    <Style x:Key="WrongChipStyle" BasedOn="{StaticResource NgChipStyle}" TargetType="{x:Type Border}" />

    <!-- Motion respects the system animation preference. -->
    <Style x:Key="ContentEntranceGridStyle" TargetType="{x:Type Grid}">
        <Setter Property="Opacity" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True">
                <DataTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                        </Storyboard>
                    </BeginStoryboard>
                </DataTrigger.EnterActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="EmptyStateEntranceStyle" TargetType="{x:Type StackPanel}">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Compatibility helpers retained for existing views and public style keys. -->
    <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="0,10,0,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondaryBrush}" />
    </Style>
    <Style x:Key="DarkFieldLabelStyle" BasedOn="{StaticResource FieldLabelStyle}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource App.DarkSecondaryTextBrush}" />
    </Style>
    <Style x:Key="StatusMessageTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource App.DangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
    </Style>
    <Style x:Key="TrimmedTextWithToolTipStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}" />
    </Style>
    <Style x:Key="AppIconStyle" TargetType="{x:Type ui:SymbolIcon}">
        <Setter Property="Width" Value="21" />
        <Setter Property="Height" Value="21" />
        <Setter Property="Margin" Value="0,0,9,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ShellRailIconStyle" BasedOn="{StaticResource AppIconStyle}" TargetType="{x:Type ui:SymbolIcon}">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

</ResourceDictionary>
