<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Light semantic surfaces -->
    <SolidColorBrush x:Key="App.BackgroundBrush" Color="{DynamicResource Color.Window}" />
    <SolidColorBrush x:Key="App.SurfaceBrush" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="App.SurfaceVariantBrush" Color="{DynamicResource Color.Gray.100}" />
    <SolidColorBrush x:Key="App.SurfaceRaisedBrush" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="App.BorderBrush" Color="{DynamicResource Color.Gray.300}" />
    <SolidColorBrush x:Key="App.DividerBrush" Color="{DynamicResource Color.Gray.200}" />
    <SolidColorBrush x:Key="App.TextPrimaryBrush" Color="{DynamicResource Color.Gray.950}" />
    <SolidColorBrush x:Key="App.TextSecondaryBrush" Color="{DynamicResource Color.Gray.700}" />
    <SolidColorBrush x:Key="App.TextMutedBrush" Color="{DynamicResource Color.Gray.600}" />

    <!-- Brand and interaction -->
    <SolidColorBrush x:Key="App.PrimaryBrush" Color="{DynamicResource Color.Indigo.600}" />
    <SolidColorBrush x:Key="App.PrimaryHoverBrush" Color="{DynamicResource Color.Indigo.700}" />
    <SolidColorBrush x:Key="App.PrimaryPressedBrush" Color="{DynamicResource Color.Navy.900}" />
    <SolidColorBrush x:Key="App.OnPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.SecondaryBrush" Color="{DynamicResource Color.Cyan.500}" />
    <SolidColorBrush x:Key="App.SecondarySurfaceBrush" Color="{DynamicResource Color.Info.100}" />
    <SolidColorBrush x:Key="App.FocusBrush" Color="{DynamicResource Color.Cyan.300}" />
    <SolidColorBrush x:Key="App.NavigationBrush" Color="{DynamicResource Color.Navy.900}" />
    <SolidColorBrush x:Key="App.NavigationRaisedBrush" Color="{DynamicResource Color.Navy.800}" />

    <!-- Semantic status -->
    <SolidColorBrush x:Key="App.SuccessBrush" Color="{DynamicResource Color.Green.700}" />
    <SolidColorBrush x:Key="App.SuccessSurfaceBrush" Color="{DynamicResource Color.Green.100}" />
    <SolidColorBrush x:Key="App.WarningBrush" Color="{DynamicResource Color.Orange.700}" />
    <SolidColorBrush x:Key="App.WarningSurfaceBrush" Color="{DynamicResource Color.Orange.100}" />
    <SolidColorBrush x:Key="App.DangerBrush" Color="{DynamicResource Color.Red.700}" />
    <SolidColorBrush x:Key="App.DangerSurfaceBrush" Color="{DynamicResource Color.Red.100}" />
    <SolidColorBrush x:Key="App.InfoBrush" Color="{DynamicResource Color.Cyan.500}" />
    <SolidColorBrush x:Key="App.InfoSurfaceBrush" Color="{DynamicResource Color.Info.100}" />
    <SolidColorBrush x:Key="App.BusyScrimBrush" Color="#B30A121C" />

    <!-- Dark palette retained for dark theme and dark application bars -->
    <SolidColorBrush x:Key="App.DarkBackgroundBrush" Color="{DynamicResource Color.Dark.Background}" />
    <SolidColorBrush x:Key="App.DarkSurfaceBrush" Color="{DynamicResource Color.Dark.Surface}" />
    <SolidColorBrush x:Key="App.DarkRaisedSurfaceBrush" Color="{DynamicResource Color.Dark.Raised}" />
    <SolidColorBrush x:Key="App.DarkBorderBrush" Color="{DynamicResource Color.Dark.Border}" />
    <SolidColorBrush x:Key="App.DarkTextBrush" Color="{DynamicResource Color.Dark.Text}" />
    <SolidColorBrush x:Key="App.DarkSecondaryTextBrush" Color="{DynamicResource Color.Dark.TextMuted}" />

    <!-- Compatibility aliases for existing views and controls -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{DynamicResource Color.Window}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{DynamicResource Color.Gray.300}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource Color.Gray.950}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource Color.Gray.700}" />
    <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="{DynamicResource Color.Indigo.600}" />
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush" Color="{DynamicResource Color.Indigo.700}" />
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush" Color="{DynamicResource Color.Navy.900}" />
    <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource Color.Green.700}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource Color.Orange.700}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{DynamicResource Color.Red.700}" />
    <SolidColorBrush x:Key="App.AccentBrush" Color="{DynamicResource Color.Indigo.600}" />
    <SolidColorBrush x:Key="App.AccentHoverBrush" Color="{DynamicResource Color.Indigo.700}" />
    <SolidColorBrush x:Key="App.AccentPressedBrush" Color="{DynamicResource Color.Navy.900}" />
    <SolidColorBrush x:Key="App.LightSurfaceBrush" Color="{DynamicResource Color.Surface}" />
    <SolidColorBrush x:Key="App.LightMutedSurfaceBrush" Color="{DynamicResource Color.Gray.100}" />
    <SolidColorBrush x:Key="App.LightBorderBrush" Color="{DynamicResource Color.Gray.300}" />
    <SolidColorBrush x:Key="App.LightTextBrush" Color="{DynamicResource Color.Gray.950}" />
    <SolidColorBrush x:Key="App.LightSecondaryTextBrush" Color="{DynamicResource Color.Gray.700}" />

</ResourceDictionary>
